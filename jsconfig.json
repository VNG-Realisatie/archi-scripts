{
  // Static type checking of jArchi scripts: JSDoc + tsc, no emit. Run: npm run typecheck
  // Scope grows module by module; see types/README.md.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2023"],
    "types": [],
    // Vendored libraries in Scripts/node_modules are not analysed; types/vendor.d.ts declares what is used.
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": false
  },
  "include": [
    "ai/jarchi-scripting/jarchi.d.ts",
    "types/*.d.ts",
    "Scripts/_lib/Common.js",
    "Scripts/_lib/archi_folders.js",
    "Scripts/_lib/selection.js",
    "Scripts/View/lib/appearance.js",
    "Scripts/View/lib/defs.js",
    "Scripts/View/lib/engines/dagre.js",
    "Scripts/View/lib/engines/elk.js",
    "Scripts/View/lib/engines/engine-utils.js",
    "Scripts/View/lib/engines/graphviz.js",
    "Scripts/View/lib/preset_io.js",
    "Scripts/View/lib/rel_filter.js"
  ]
}
