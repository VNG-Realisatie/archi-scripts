/**
 * Import van de GGM relaties
 *
 * Specificatie CSV-bestanden
 * - https://github.com/VNG-Realisatie/GEMMA-GGM-Archi-repository/tree/develop/CSV%20export
 *
 * Voordat dit script gedraaid wordt:
 * - maak een Archi compatible versie van de GGM csv met LibreOffice calc
 * - de GGM data-objecten moeten ingelezen zijn
 *
 * Dit script leest de GGM relaties
 * - associaties en specialisaties tussen data-objecten
 */
load(__DIR__ + "../_lib/Common.js");
initConsoleLog(__FILE__, true);

load("../_lib/archi_folders.js");
load("include_ggm_gemma.js");
// Overrule PROP_ID: vind bestaande relaties met PROP_GGM_ID_IMPORTED ipv Object ID
var PROP_ID = PROP_GGM_ID_IMPORTED;
load(__DIR__ + "../ImportExport_CSV/include_import.js");

let relationsCSV = Config.getPath("relations");
if (!relationsCSV) {
  relationsCSV = window.promptOpenFile({
    title: "Enter path for GGM relations CSV file:",
    filterExtensions: ["*.csv"],
    fileName: "*.csv",
  });
  if (!relationsCSV) {
    console.log("Geen relations CSV file gekozen.");
    exit();
  }
}

console.log("Using relations CSV file: " + relationsCSV);

// importObjects(relationsCSV, null, transformHeaderGGM, transformRowGGM);
importObjects(relationsCSV, null, transformRowGGM);

// move added data-objectrelations
let dataobjectRelations = $(getFolderPath("/Relations"))
  .children("relationship")
  .filter((rel) => rel.prop(PROP_GGM_ID_IMPORTED) != undefined);
let folderDataobjectRelations = getFolderPath("/Relations" + FOLDER_GGM_DATAOBJECT);
console.log(`\n> move ${dataobjectRelations.size()} created relations to ${folderDataobjectRelations}`);

dataobjectRelations.each((rel) => {
  // debug(`rel: ${rel}`)
  folderDataobjectRelations.add(rel);
});

// and set Object ID
console.log(`> and set a property 'Object ID'`);
dataobjectRelations.each((rel) => {
  if (!rel.prop("Object ID")) rel.prop("Object ID", generateUUID());
});

finishConsoleLog();

/*
================================================================================
TRANSFORM GGM CSV-file for Archi import
================================================================================
name                                 ← GGM-naam
                                      Used as the output relation name.
type                                 ← GGM-uml-type
                                      Derived: Association → "association-relationship",
                                      otherwise "specialization-relationship".
documentation                        ← GGM-definitie
                                      Copied to output documentation.
id                                   ← (constant "")
                                      Empty placeholder; Archi fills this later.
source.id                            ← GEMMA-source-guid
                                      Output source element ID.
target.id                            ← GEMMA-target-guid
                                      Output target element ID.
GGM-toelichting                      ← GGM-toelichting
                                      Copied unchanged.
GGM-guid-imported                    ← GGM-guid
                                      Imported original GGM relation GUID.
source.prop.GGM-guid-imported        ← GGM-source-guid
                                      Imported original GGM source GUID.
target.prop.GGM-guid-imported        ← GGM-target-guid
                                      Imported original GGM target GUID.
Datum-tijd-export                    ← datum-tijd-export
                                      Copied unchanged.
source.name                          ← (constant "")
                                      Empty placeholder; filled later.
source.type                          ← (constant "data-object")
                                      Fixed element type.
target.name                          ← (constant "")
                                      Empty placeholder; filled later.
target.type                          ← (constant "data-object")
                                      Fixed element type.
GGM-uml-type                         ← GGM-uml-type
                                      Copied unchanged.
associationDirected                  ← GGM-uml-type
                                      "true" if Association, otherwise "false".
================================================================================
*/

function transformRowGGM(row) {
  const uml = row["GGM-uml-type"] || "";
  const isAssociation = uml === "Association";

  return {
    name: row["GGM-naam"] || "",
    type: isAssociation ? "association-relationship" : "specialization-relationship",
    documentation: row["GGM-definitie"] || "",
    id: "",

    "source.id": row["GEMMA-source-guid"] || "",
    "target.id": row["GEMMA-target-guid"] || "",

    "GGM-toelichting": row["GGM-toelichting"] || "",
    "GGM-guid-imported": row["GGM-guid"] || "",
    "source.prop.GGM-guid-imported": row["GGM-source-guid"] || "",
    "target.prop.GGM-guid-imported": row["GGM-target-guid"] || "",

    "Datum-tijd-export": row["datum-tijd-export"] || "",

    "source.name": "",
    "source.type": "data-object",
    "target.name": "",
    "target.type": "data-object",

    "GGM-uml-type": uml,
    associationDirected: isAssociation ? "true" : "false"
  };
}
