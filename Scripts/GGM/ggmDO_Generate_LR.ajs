/**
 * Wrapper file for generating and/or layout a view
 *
 * The filename defines which parameter are used
 * Format of the filename:
 * - <user parameter filename>_<action>_<direction>.ajs
 */
const Common = require(__DIR__ + "/../_lib/Common.js");
const Selection = require(__DIR__ + "/../_lib/selection.js");
const ArchiFolders = require(__DIR__ + "/../_lib/archi_folders.js");
const View = require(__DIR__ + "/../View/include_view.js");

Common.initConsoleLog(__FILE__, true);

let param = {};
param = View.get_default_parameter(__FILE__);
param = View.get_user_parameter(__FILE__, param);

View.generate_view(param);
Common.finishConsoleLog();