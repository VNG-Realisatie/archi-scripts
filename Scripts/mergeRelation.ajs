/**
 * Merge all duplicate relations with the selected relations
 *  - duplicate relations have the same type, source, target and name
 *  - the selected concepts are kept, the duplicates are merged and then deleted
 *
 * Usage:
 *  Select one or more relations.
 *  - on a view or in the model-tree
 *  - or select folders/views containing the relations.
 *  Run the script
 *
 * (c) 2019 Mark Backer
 *
 * 06 2023: logic is now part of includeMergeConcept
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();

const Common = require(REPO_ROOT + "_lib/Common.js");
const Merge = require(REPO_ROOT + "_lib/includeMergeConcept.js");
const Selection = require(REPO_ROOT + "_lib/selection.js");

Common.initConsoleLog(__FILE__);

let selectedConcepts = Selection.getSelection($(selection), Common.OBJECT_TYPE_RELATION);
// console.log(`Selected concepts: ${selectedConcepts}`);
Merge.mergeConcept(selectedConcepts, Common.OBJECT_TYPE_RELATION);

Common.finishConsoleLog();
