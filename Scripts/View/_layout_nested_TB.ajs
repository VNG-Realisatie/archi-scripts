/**
 * Wrapper file for generating and/or layout a view
 *
 * The filename defines which parameter are used
 * Format of the filename:
 * - <user parameter filename>_<action>_<direction>.ajs
 */

const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common");
const View = require(REPO_ROOT + "View/include_view");

Common.initConsoleLog(__FILE__, true);

let param = {};
param = View.get_default_parameter(__FILE__);

param.action = View.LAYOUT;
param.graphDirection = "TB";
param.layoutReversed = [
  // "access-relationship",
  // "aggregation-relationship",
  // "assignment-relationship",
  // "association-relationship",
  // "composition-relationship",
  // "flow-relationship",
  // "influence-relationship",
  "realization-relationship",
  // "serving-relationship",
  "specialization-relationship",
  // "triggering-relationship",
];
param.layoutNested = [
  // "access-relationship",
  "aggregation-relationship",
  // "assignment-relationship",
  // "association-relationship",
  // "composition-relationship",
  // "flow-relationship",
  // "influence-relationship",
  // "realization-relationship",
  // "serving-relationship",
  "specialization-relationship",
  // "triggering-relationship",
];
// param.nodeWidth = 140;
// param.nodeHeight = 61;
// param.hSep = 40;
// param.vSep = 20;

View.generate_view(param);
Common.finishConsoleLog();
