/**
 * experimental
 * 
 * regenerate a view from a previously generated view.
 * the param is read from the property 'generate_view_param' of the selected view 
 * 
 * Usage:
 * - select a view (in the model or click in a view on the background)
 * - run this script
 */

const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common");
const View = require(REPO_ROOT + "View/include_view");

var param = {
  action: View.REGENERATE,
};

Common.initConsoleLog(__FILE__, true);
View.generate_view(param);
Common.finishConsoleLog();