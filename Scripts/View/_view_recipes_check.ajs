/** Check the view recipes of the open model and the presets linked to them; writes nothing. */
if (typeof require !== "function") { const m = "This script needs jArchi 1.11 or later, with CommonJS on: in Archi, open Preferences > Scripting and tick \"Enable CommonJS Support\" (no such option: update jArchi first). Then run the script again."; try { window.alert(m); } catch (e) { console.error(m); } exit(); }
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Log            = require(REPO_ROOT + "_lib/log");
const ViewRecipe     = require(REPO_ROOT + "View/lib/view_recipe");
const ViewRecipeRead = require(REPO_ROOT + "View/lib/view_recipe_read");
Log.start(__FILE__, true);
if (!model.isSet()) Log.error("No model selected.", "Select something in the model to check, then run the script again.");
else {
  const facts = ViewRecipeRead.readFacts(), presets = ViewRecipeRead.readPresetLinks();
  ViewRecipe.logFindings(facts, presets, ViewRecipe.check(facts, presets));
}
Log.finish();
