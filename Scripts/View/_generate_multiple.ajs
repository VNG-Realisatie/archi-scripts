/**
 * JArchi script that generates a view for every selected element
 * - define with the param objects what to include in the generated views
 * - the views will be called "<element name> generated"
 *
 * Requires:
 *     Archi:			https://www.archimatetool.com
 *     jArchi plugin:	https://www.archimatetool.com/plugins
 *     Java script:		generate_view.js
 *
 *  #	date		Author			Comments
 *  1	28/01/2019	Hervé Jouin		File creation.
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common");
const View = require(REPO_ROOT + "View/include_view");

Common.initConsoleLog(__FILE__, true);

let param = View.get_default_parameter(__FILE__);
param.action = View.GENERATE_MULTIPLE

View.generate_view(param);
Common.finishConsoleLog();
