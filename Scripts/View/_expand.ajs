/**
 * Expand in a view the selected element(s) with their related elements (add elements and relations 1 
 * 
 * Usage:
 * - in a view select one or more elements
 * - run this script
 * 
 * In the view the selected elements are 'expanded' with their missing relations
 * 
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common");
const View = require(REPO_ROOT + "View/include_view_presets");

Common.initConsoleLog(__FILE__, true);

let param = View.get_default_parameter(__FILE__);
param.action = View.EXPAND_HERE

View.generate_view(param);
Common.finishConsoleLog();
