/**
 * Generate the views of the view recipes: nothing selected, or the view or folder View recipes, is every preset
 * linked to a recipe in the open model; else the selected recipes. The check runs first; views made from a recipe
 * that this run left behind (stale views) are listed and, after one confirmation, deleted.
 * On Archi's command line nobody is asked: the stale views are deleted only with DELETE_STALE=true, and the model is saved.
 */
if (typeof require !== "function") { const m = "This script needs jArchi 1.11 or later, with CommonJS on: in Archi, open Preferences > Scripting and tick \"Enable CommonJS Support\" (no such option: update jArchi first). Then run the script again."; try { window.alert(m); } catch (e) { console.error(m); } exit(); }
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Log       = require(REPO_ROOT + "_lib/log");
const RunPreset = require(REPO_ROOT + "View/lib/run_preset");
Log.start(__FILE__, true);
RunPreset.fromRecipes(typeof selection === "undefined" ? $() : $(selection), { deleteStale: Java.type("java.lang.System").getenv("DELETE_STALE") === "true" });
Log.finish();
