  <folder name="Application" id="id-e120a425cca5538fa156eecbed02f4e6" type="application">
    <folder name="View subsystem" id="id-16bd3e1e920856b2a65ae768830ad3a4">
      <folder name="Dialog" id="id-77e7d83359495e45b0409d327f5379f3">
        <property key="view-architecture export date" value="2026-11-03T16:31:01.749Z"/>
        <element xsi:type="archimate:ApplicationComponent" name="_gui.ajs" id="id-8fd091ffa77e5caba05bbf61c447e496">
          <documentation>The only script that opens the Generate View dialog. Captures the Archi selection before the dialog opens (focus loss can clear it); the chosen action runs after the dialog closes. Calls: dialog_main.open().</documentation>
          <property key="path" value="Scripts/View/_gui.ajs"/>
          <property key="runtime" value="Archi"/>
          <property key="typechecked" value="no"/>
          <property key="view-architecture export date" value="2026-11-03T16:31:01.749Z"/>
        </element>
        <element xsi:type="archimate:ApplicationComponent" name="dialog_main.js" id="id-6f30747c1d1c5c11bfd7a976cfaf0c07">
          <documentation>The Generate View dialog (SWT/JFace): opens on the captured selection, reads the session, builds the preset row and four tabs, keeps settings and widgets in sync and shows the live counts. An action closes it, saves the session and calls generate_view.

Main export: open().</documentation>
          <property key="path" value="Scripts/View/lib/gui/dialog_main.js"/>
          <property key="runtime" value="Archi"/>
          <property key="typechecked" value="yes"/>
