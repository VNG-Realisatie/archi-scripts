/**
 * Interactive Graphical User Interface for View Layout Parameters
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common");

Common.initConsoleLog(__FILE__, true);

const View = require(REPO_ROOT + "View/include_view");
const File = Java.type("java.io.File");
const FileWriter = Java.type("java.io.FileWriter");
const FileReader = Java.type("java.io.FileReader");
const BufferedReader = Java.type("java.io.BufferedReader");

// Capture selection before opening the SWT dialog causes focus loss
const initialSelection = $(selection);

const SWT = Java.type("org.eclipse.swt.SWT");
const LabelWidget = Java.type("org.eclipse.swt.widgets.Label");
const CompositeWidget = Java.type("org.eclipse.swt.widgets.Composite");
const SpinnerWidget = Java.type("org.eclipse.swt.widgets.Spinner");
const GroupWidget = Java.type("org.eclipse.swt.widgets.Group");
const ButtonWidget = Java.type("org.eclipse.swt.widgets.Button");
const ComboWidget = Java.type("org.eclipse.swt.widgets.Combo");
const TabFolderWidget = Java.type("org.eclipse.swt.widgets.TabFolder");
const TabItemWidget = Java.type("org.eclipse.swt.widgets.TabItem");
const ScrolledCompositeWidget = Java.type("org.eclipse.swt.custom.ScrolledComposite");
const TextWidget = Java.type("org.eclipse.swt.widgets.Text");
const ListWidget = Java.type("org.eclipse.swt.widgets.List");
const GridDataFactory = Java.type("org.eclipse.jface.layout.GridDataFactory");
const GridLayoutFactory = Java.type("org.eclipse.jface.layout.GridLayoutFactory");
const TitleAreaDialog = Java.type("org.eclipse.jface.dialogs.TitleAreaDialog");
const IMessageProvider = Java.type("org.eclipse.jface.dialogs.IMessageProvider");

// Helper to list parameter files
function getPresetFiles() {
  var dir = new File(__DIR__ + "user_parameter");
  var files = dir.listFiles();
  var names = [];
  if (files) {
    for (var i = 0; i < files.length; i++) {
      if (files[i].isFile() && files[i].getName().endsWith(".js")) {
        names.push(files[i].getName());
      }
    }
  }
  return names;
}

// Interacting with File system natively to avoid Node.js limitations
function writeJSON(path, obj) {
  try {
    var writer = new FileWriter(path);
    writer.write(JSON.stringify(obj, null, 2));
    writer.close();
  } catch (e) {
    console.error("Failed to write state:", e);
  }
}

function readJSON(path) {
  try {
    var reader = new BufferedReader(new FileReader(path));
    var line = "";
    var content = "";
    while ((line = reader.readLine()) != null) content += line;
    reader.close();
    return JSON.parse(content);
  } catch (e) {
    return null;
  }
}

function writePreset(filename, obj) {
  if (!filename.endsWith(".js")) filename += ".js";
  var path = __DIR__ + "user_parameter/" + filename;
  var writer = new FileWriter(path);
  writer.write("/**\n * Saved from _GUI.ajs\n */\n\nmodule.exports = " + JSON.stringify(obj, null, 2) + ";\n");
  writer.close();
}

// Determine defaults
const LAST_RUN_FILE = __DIR__ + ".last_gui_run_params.json";
let defaultParams = readJSON(LAST_RUN_FILE);

if (!defaultParams) {
  try {
    defaultParams = require(__DIR__ + "user_parameter/default_parameter.js");
  } catch (e) {
    defaultParams = {
      action: View.GENERATE_SINGLE,
      graphDepth: 1,
      includeElementType: [],
      includeRelationType: [],
      excludeFromView: false,
      layoutReversed: [],
      layoutNested: [],
      nestingMultipleOccurrences: false,
      viewName: "",
      viewNameSuffix: "",
      viewFolder: "",
      elkAlgorithm:       View.DEFAULT_ELK_ALGORITHM,
      elkDirection:       View.DEFAULT_ELK_DIRECTION,
      elkSpacingNodeNode: View.DEFAULT_ELK_SPACING,
      elkLayerSpacing:    View.DEFAULT_ELK_LAYER_SEP,
      elkNodePlacementAlignment: View.DEFAULT_ELK_NODE_PLACEMENT,
      elkEdgeRouting:     View.DEFAULT_ELK_EDGE_ROUTING,
      elkPadding:         View.DEFAULT_ELK_PADDING,
      nodeWidth:  200,
      nodeHeight: 60,
      debug: false,
    };
  }
}

const ConfigDialog = Java.extend(TitleAreaDialog);

let layoutDialog = {
  config: defaultParams,
  widgets: {},

  createWidget: function (name, widgetClass, container, label, tooltip, init, flags) {
    if (flags === undefined) flags = SWT.BORDER;

    if (label != null) {
      let txt = new LabelWidget(container, SWT.NONE);
      txt.setText(label);
      if (tooltip) txt.setToolTipText(tooltip);
      if (name != null) this.widgets[name + '_lbl'] = txt;
    }

    let widget = new widgetClass(container, flags);
    if (tooltip) widget.setToolTipText(tooltip);
    if (init != null) init(widget);
    if (name != null) this.widgets[name] = widget;

    return widget;
  },

  createListBuilder: function (name, container, label, tooltip, availableItems, initialSelected) {
    if (label != null) {
      let txt = new LabelWidget(container, SWT.NONE);
      txt.setText(label);
      if (tooltip) txt.setToolTipText(tooltip);
      GridDataFactory.fillDefaults().span(2, 1).applyTo(txt);
    }

    let mainComp = new CompositeWidget(container, SWT.NONE);
    GridDataFactory.fillDefaults().grab(true, true).span(2, 1).applyTo(mainComp);
    GridLayoutFactory.swtDefaults().numColumns(3).margins(0, 0).applyTo(mainComp);

    // Left: Search + Available
    let leftComp = new CompositeWidget(mainComp, SWT.NONE);
    GridDataFactory.fillDefaults().grab(true, true).applyTo(leftComp);
    GridLayoutFactory.swtDefaults().numColumns(1).margins(0, 0).applyTo(leftComp);

    let txtSearch = new TextWidget(leftComp, SWT.BORDER | SWT.SEARCH | SWT.ICON_SEARCH | SWT.ICON_CANCEL);
    txtSearch.setMessage("Type to search...");
    GridDataFactory.fillDefaults().grab(true, false).applyTo(txtSearch);

    let lstAvailable = new ListWidget(leftComp, SWT.BORDER | SWT.V_SCROLL);
    GridDataFactory.fillDefaults().grab(true, true).hint(SWT.DEFAULT, 100).applyTo(lstAvailable);

    function updateAvailable() {
      lstAvailable.removeAll();
      let q = txtSearch.getText().toLowerCase();
      availableItems.forEach(function (item) {
        if (item.toLowerCase().indexOf(q) >= 0) {
          lstAvailable.add(item);
        }
      });
    }
    updateAvailable();

    txtSearch.addListener(SWT.Modify, function () {
      updateAvailable();
    });

    // Middle: Buttons
    let btnComp = new CompositeWidget(mainComp, SWT.NONE);
    GridDataFactory.fillDefaults().align(SWT.CENTER, SWT.CENTER).applyTo(btnComp);
    GridLayoutFactory.swtDefaults().numColumns(1).margins(5, 0).applyTo(btnComp);

    let btnAdd = new ButtonWidget(btnComp, SWT.PUSH);
    btnAdd.setText("Add >");
    GridDataFactory.fillDefaults().hint(70, SWT.DEFAULT).applyTo(btnAdd);

    let btnRemove = new ButtonWidget(btnComp, SWT.PUSH);
    btnRemove.setText("< Remove");
    GridDataFactory.fillDefaults().hint(70, SWT.DEFAULT).applyTo(btnRemove);

    // Right: Selected
    let rightComp = new CompositeWidget(mainComp, SWT.NONE);
    GridDataFactory.fillDefaults().grab(true, true).applyTo(rightComp);
    GridLayoutFactory.swtDefaults().numColumns(1).margins(0, 0).applyTo(rightComp);

    let lblSelected = new LabelWidget(rightComp, SWT.NONE);
    lblSelected.setText("Selected (Double-click to remove):");

    let lstSelected = new ListWidget(rightComp, SWT.BORDER | SWT.V_SCROLL | SWT.MULTI);
    GridDataFactory.fillDefaults().grab(true, true).hint(SWT.DEFAULT, 100).applyTo(lstSelected);

    function applySelection() {
      let sel = lstAvailable.getSelection();
      if (sel.length === 0) {
        let q = txtSearch.getText().trim();
        if (q !== "" && q !== "Type to search...") sel = [q];
      }
      for (let i = 0; i < sel.length; i++) {
        let has = false;
        for (let j = 0; j < lstSelected.getItemCount(); j++) {
          if (lstSelected.getItem(j) === sel[i]) has = true;
        }
        if (!has) lstSelected.add(sel[i]);
      }
      txtSearch.setText(""); // clear search
    }

    function removeSelection() {
      let indices = lstSelected.getSelectionIndices();
      lstSelected.remove(indices);
    }

    btnAdd.addListener(SWT.Selection, applySelection);
    lstAvailable.addListener(SWT.MouseDoubleClick, applySelection);
    txtSearch.addListener(SWT.DefaultSelection, applySelection); // Enter key

    btnRemove.addListener(SWT.Selection, removeSelection);
    lstSelected.addListener(SWT.MouseDoubleClick, removeSelection);

    // Save reference to the selected list for data extraction
    this.widgets[name] = lstSelected;

    // Initialize values
    if (initialSelected && initialSelected.length > 0) {
      initialSelected.forEach(function (item) {
        lstSelected.add(item);
      });
    }
  },

  promptPresetReview: function (presetName, newConfig) {
    let diffs = [];

    // mapping for human readability
    let map = {
      action:                 "Action",
      graphDepth:             "Graph Depth",
      includeElementType:     "Element Filter",
      includeRelationType:    "Relationship Filter",
      excludeFromView:        "Exclude Flag",
      layoutReversed:         "Reverse Relations",
      layoutNested:           "Nested Relations",
      nestingMultipleOccurrences: "Multiple Occurrences",
      viewName:               "View Name",
      viewNameSuffix:         "View Suffix",
      viewFolder:             "View Folder",
      elkAlgorithm:           "ELK Algorithm",
      elkDirection:           "Direction",
      elkNodePlacementAlignment: "Node placement",
      elkEdgeRouting:         "Edge Routing",
      elkSpacingNodeNode:     "Node Spacing",
      elkLayerSpacing:        "Layer Spacing",
      elkPadding:             "Nested Padding",
      nodeWidth:              "Node Width",
      nodeHeight:             "Node Height",
      debug:                  "Debug Trace",
    };

    Object.keys(newConfig).forEach((k) => {
      let oldVal = this.config[k];
      let newVal = newConfig[k];
      let oldStr = Array.isArray(oldVal) ? oldVal.join(", ") : String(oldVal);
      let newStr = Array.isArray(newVal) ? newVal.join(", ") : String(newVal);

      if (oldStr !== newStr) {
        diffs.push({
          key: map[k] || k,
          oldV: oldStr ? oldStr : "(empty)",
          newV: newStr ? newStr : "(empty)",
        });
      }
    });

    if (diffs.length === 0) {
      window.alert("Preset '" + presetName + "' is identical to your current settings.");
      return false;
    }

    let ReviewDialogClass = Java.extend(TitleAreaDialog);
    let okPressed = false;

    let dlg = new ReviewDialogClass(shell, {
      create: function () {
        Java.super(dlg).create();
        dlg.setTitle("Review Preset: " + presetName);
        dlg.setMessage("Please review the parameter changes before applying them.", IMessageProvider.INFORMATION);
        dlg.getShell().setSize(700, 500);
        dlg.getShell().setText("Preset Review");
      },
      createDialogArea: function (parent) {
        let area = Java.super(dlg).createDialogArea(parent);
        let container = new CompositeWidget(area, SWT.NONE);
        GridDataFactory.fillDefaults().grab(true, true).applyTo(container);
        GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(container);

        let table = new org.eclipse.swt.widgets.Table(container, SWT.BORDER | SWT.FULL_SELECTION | SWT.V_SCROLL);
        table.setHeaderVisible(true);
        table.setLinesVisible(true);
        GridDataFactory.fillDefaults().grab(true, true).applyTo(table);

        let col1 = new org.eclipse.swt.widgets.TableColumn(table, SWT.NONE);
        col1.setText("Parameter");
        col1.setWidth(150);

        let col2 = new org.eclipse.swt.widgets.TableColumn(table, SWT.NONE);
        col2.setText("Current Value");
        col2.setWidth(250);

        let col3 = new org.eclipse.swt.widgets.TableColumn(table, SWT.NONE);
        col3.setText("Preset Value");
        col3.setWidth(250);

        let TableItem = Java.type("org.eclipse.swt.widgets.TableItem");
        diffs.forEach((d) => {
          let item = new TableItem(table, SWT.NONE);
          item.setText(0, d.key);
          item.setText(1, d.oldV);
          item.setText(2, d.newV);
        });

        return area;
      },
      isResizable: function () {
        return true;
      },
      createButtonsForButtonBar: function (parent) {
        let IDialogConstants = Java.type("org.eclipse.jface.dialogs.IDialogConstants");
        Java.super(dlg).createButton(parent, IDialogConstants.OK_ID, "Apply Changes", true);
        Java.super(dlg).createButton(parent, IDialogConstants.CANCEL_ID, IDialogConstants.CANCEL_LABEL, false);
      },
      okPressed: function () {
        okPressed = true;
        Java.super(dlg).okPressed();
      },
    });

    dlg.open();
    return okPressed;
  },

  updateFromPreset: function (presetName) {
    try {
      let newCfg = require(__DIR__ + "user_parameter/" + presetName);

      if (this.promptPresetReview(presetName, newCfg)) {
        Object.keys(newCfg).forEach((k) => {
          this.config[k] = newCfg[k];
        });
        this.syncConfigToUI();
      }
    } catch (e) {
      console.error("Could not load preset " + presetName, e);
      window.alert("Error loading preset: " + e);
    }
  },

  syncConfigToUI: function () {
    let setRadio = (group, val) => {
      let children = group.getChildren();
      let hasSelection = false;
      let firstRadio = null;
      for (let i = 0; i < children.length; i++) {
        let dataVal = children[i].getData("val");
        if (dataVal !== null && dataVal !== undefined) {
          if (!firstRadio) firstRadio = children[i];
          if (dataVal === val) {
            children[i].setSelection(true);
            hasSelection = true;
          } else {
            children[i].setSelection(false);
          }
        }
      }
      if (!hasSelection && firstRadio !== null) {
        firstRadio.setSelection(true);
      }
    };

    let setBuilder = (wList, arr) => {
      wList.removeAll();
      if (!arr || !arr.length) return;
      arr.forEach((item) => wList.add(item));
    };

    if (this.widgets.grpActionControls) setRadio(this.widgets.grpActionControls, this.config.action);
    if (this.config.graphDepth !== undefined) this.widgets.spinDepth.setSelection(this.config.graphDepth);

    setBuilder(this.widgets.lstElemTypes, this.config.includeElementType);
    setBuilder(this.widgets.lstRelTypes,  this.config.includeRelationType);

    if (this.widgets.grpAlgorithm) {
      setRadio(this.widgets.grpAlgorithm, this.config.elkAlgorithm || View.DEFAULT_ELK_ALGORITHM);
      this.updateAlgoControls(this.config.elkAlgorithm || View.DEFAULT_ELK_ALGORITHM);
    }
    if (this.widgets.grpDir)         setRadio(this.widgets.grpDir,         this.config.elkDirection    || View.DEFAULT_ELK_DIRECTION);
    if (this.widgets.grpNodePlacement) setRadio(this.widgets.grpNodePlacement, this.config.elkNodePlacementAlignment || View.DEFAULT_ELK_NODE_PLACEMENT);
    if (this.widgets.grpEdgeRouting) setRadio(this.widgets.grpEdgeRouting, this.config.elkEdgeRouting  || View.DEFAULT_ELK_EDGE_ROUTING);

    if (this.config.nodeWidth)          this.widgets.spinWidth.setSelection(this.config.nodeWidth);
    if (this.config.nodeHeight)         this.widgets.spinHeight.setSelection(this.config.nodeHeight);
    if (this.config.elkSpacingNodeNode) this.widgets.spinNodeSep.setSelection(this.config.elkSpacingNodeNode);
    if (this.config.elkLayerSpacing)    this.widgets.spinLayerSep.setSelection(this.config.elkLayerSpacing);
    if (this.config.elkPadding !== undefined) this.widgets.spinPadding.setSelection(this.config.elkPadding);

    setBuilder(this.widgets.lstReversed, this.config.layoutReversed);
    setBuilder(this.widgets.lstNested,   this.config.layoutNested);

    if (this.widgets.chkMultiOcc) this.widgets.chkMultiOcc.setSelection(!!this.config.nestingMultipleOccurrences);

    if (initialSelection && initialSelection.length > 0) {
      let firstObj = initialSelection.first();
      if (firstObj && firstObj.name) {
        this.widgets.txtViewName.setText(firstObj.name);
      } else {
        this.widgets.txtViewName.setText("");
      }
    } else {
      this.widgets.txtViewName.setText("");
    }

    if (this.widgets.chkDebug && this.config.debug !== undefined) this.widgets.chkDebug.setSelection(this.config.debug);
  },

  saveInput: function () {
    let getRadioVal = (group) => {
      let children = group.getChildren();
      for (let i = 0; i < children.length; i++) {
        let dataVal = children[i].getData("val");
        if (dataVal !== null && dataVal !== undefined && typeof children[i].getSelection === "function") {
          if (children[i].getSelection()) {
            return dataVal;
          }
        }
      }
      return undefined;
    };

    this.config.action = getRadioVal(this.widgets.grpActionControls);
    if (this.config.action === "None") this.config.action = undefined;

    this.config.graphDepth    = this.widgets.spinDepth.getSelection();
    this.config.excludeFromView = false;

    let toJsArray = (wList) => {
      let res = [];
      let items = wList.getItems();
      if (items) {
        for (let i = 0; i < items.length; i++) res.push(String(items[i]));
      }
      return res;
    };

    this.config.includeElementType  = toJsArray(this.widgets.lstElemTypes);
    this.config.includeRelationType = toJsArray(this.widgets.lstRelTypes);

    this.config.elkAlgorithm       = getRadioVal(this.widgets.grpAlgorithm);
    this.config.elkDirection        = getRadioVal(this.widgets.grpDir);
    this.config.elkNodePlacementAlignment = getRadioVal(this.widgets.grpNodePlacement);
    this.config.elkEdgeRouting      = getRadioVal(this.widgets.grpEdgeRouting);

    this.config.nodeWidth           = this.widgets.spinWidth.getSelection();
    this.config.nodeHeight          = this.widgets.spinHeight.getSelection();
    this.config.elkSpacingNodeNode  = this.widgets.spinNodeSep.getSelection();
    this.config.elkLayerSpacing     = this.widgets.spinLayerSep.getSelection();
    this.config.elkPadding          = this.widgets.spinPadding.getSelection();

    this.config.layoutReversed      = toJsArray(this.widgets.lstReversed);
    this.config.layoutNested        = toJsArray(this.widgets.lstNested);
    this.config.nestingMultipleOccurrences = this.widgets.chkMultiOcc.getSelection();

    this.config.viewName       = String(this.widgets.txtViewName.getText()).trim();
    this.config.viewNameSuffix = undefined;
    this.config.viewFolder     = undefined;

    this.config.debug = this.widgets.chkDebug.getSelection();
  },

  updateAlgoControls: function (algo) {
    if (!this.widgets.grpDir) return;
    var CAPS = {
      layered: { dir: true,  nodePlacement: true,  routing: true,  layerSep: true,  note: 'layered: all parameters apply.' },
      mrtree:  { dir: true,  nodePlacement: false, routing: true,  layerSep: true,  note: 'mrtree: Node placement is ignored.' },
      force:   { dir: false, nodePlacement: false, routing: false, layerSep: false, note: 'force: Direction, Node placement, Edge Routing and Layer Spacing are ignored.' },
      box:     { dir: false, nodePlacement: false, routing: false, layerSep: false, note: 'box: Direction, Node placement, Edge Routing and Layer Spacing are ignored.' },
      stress:  { dir: false, nodePlacement: false, routing: false, layerSep: false, note: 'stress: Direction, Node placement, Edge Routing and Layer Spacing are ignored.' },
      radial:  { dir: false, nodePlacement: false, routing: false, layerSep: true,  note: 'radial: Direction, Node placement and Edge Routing are ignored; Layer Spacing sets the radius.' },
      dagre:   { dir: true,  nodePlacement: false, routing: false, layerSep: true,  note: 'dagre: Direction, Node Spacing and Layer Spacing apply. Node placement and Edge Routing are ELK-only. Add ranker to parameter file (default: network-simplex).' },
    };
    var c = CAPS[algo] || CAPS['layered'];
    function setRowEnabled(comp, enabled) {
      var ch = comp.getChildren();
      for (var i = 0; i < ch.length; i++) ch[i].setEnabled(enabled);
    }
    setRowEnabled(this.widgets.grpDir,           c.dir);
    setRowEnabled(this.widgets.grpNodePlacement,  c.nodePlacement);
    setRowEnabled(this.widgets.grpEdgeRouting,    c.routing);
    if (this.widgets.spinLayerSep)     this.widgets.spinLayerSep.setEnabled(c.layerSep);
    if (this.widgets.spinLayerSep_lbl) this.widgets.spinLayerSep_lbl.setEnabled(c.layerSep);
    if (this.widgets.lblAlgoNote)      this.widgets.lblAlgoNote.setText(c.note);
  },

  open: function () {
    return this.dialog.open() == 0;
  },

  dialog: new ConfigDialog(shell, {
    create: function () {
      Java.super(layoutDialog.dialog).create();
      layoutDialog.dialog.setTitle("View generation and layout");
      layoutDialog.dialog.setMessage(
        "Modify parameters to auto-generate and layout your selection or view.",
        IMessageProvider.INFORMATION,
      );
      let _sh = layoutDialog.dialog.getShell();
      let _ca = _sh.getMonitor().getClientArea();
      _sh.setSize(Math.min(820, _ca.width - 50), Math.min(900, _ca.height - 80));
    },

    createDialogArea: function (parent) {
      let area = Java.super(layoutDialog.dialog).createDialogArea(parent);

      let container = new CompositeWidget(area, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(container);
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(container);

      let tabFolder = new TabFolderWidget(container, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(tabFolder);

      // Helper for mapping radio buttons
      function createRadios(parentGrp, options) {
        options.forEach((opt) => {
          let r = new ButtonWidget(parentGrp, SWT.RADIO);
          r.setText(opt.label + "   ");
          r.setData("val", opt.val);
          if (opt.tooltip) r.setToolTipText(opt.tooltip);
        });
      }

      // --- TAB 1: Generate and layout ---
      let tabLayout = new TabItemWidget(tabFolder, SWT.NONE);
      tabLayout.setText("  Generate and layout  ");
      let scrolled1 = new ScrolledCompositeWidget(tabFolder, SWT.H_SCROLL | SWT.V_SCROLL);
      scrolled1.setExpandHorizontal(true);
      scrolled1.setExpandVertical(true);
      let layoutContainer = new CompositeWidget(scrolled1, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(layoutContainer);
      tabLayout.setControl(scrolled1);

      // View Metadata Group
      let grpMeta = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(grpMeta);
      grpMeta.setText("View");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpMeta);

      layoutDialog.createWidget(
        "txtViewName",
        TextWidget,
        grpMeta,
        "View Name:",
        "Explicit name (default follows selection name)",
        function (w) {
          GridDataFactory.fillDefaults().grab(true, false).applyTo(w);
        },
      );
      let lblFolder = new LabelWidget(grpMeta, SWT.NONE);
      lblFolder.setText("Views are stored in the Archi folder: Views/_Generated");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblFolder);

      // Action Group
      let grpActionControls = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(grpActionControls);
      grpActionControls.setText("Action");
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(grpActionControls);
      layoutDialog.widgets.grpActionControls = grpActionControls;

      let actionOpts = [
        {
          label: "Generate view",
          tooltip: "Generate a view with selected elements and their related elements",
          val: View.GENERATE_SINGLE,
        },
        {
          label: "Generate multiple context views",
          tooltip: "Generate a context view for each selected element. Views will be named after the central element.",
          val: View.GENERATE_MULTIPLE,
        },
        {
          label: "Expand selected elements",
          tooltip: "For the selected elements the related elements will be added to the view",
          val: View.EXPAND_HERE,
        },
        { label: "Layout selected view", tooltip: "Apply layout settings to the selected view", val: View.LAYOUT },
      ];
      createRadios(grpActionControls, actionOpts);

      layoutDialog.createWidget(
        "spinDepth",
        SpinnerWidget,
        grpActionControls,
        "Graph Depth (Generate actions only):",
        "Number of relations to follow outward from the selected elements.",
        function (w) {
          w.setValues(1, 0, 10, 0, 1, 1);
        },
      );

      // Algorithm Group (ELK)
      let grpELK = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(grpELK);
      grpELK.setText("Algorithm");
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(grpELK);

      // Algorithm row
      let cAlgo = new CompositeWidget(grpELK, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(8).applyTo(cAlgo);
      new LabelWidget(cAlgo, SWT.NONE).setText("Algorithm:");
      layoutDialog.widgets.grpAlgorithm = cAlgo;
      createRadios(cAlgo, [
        { label: "layered",  val: "layered",  tooltip: "Layered — ArchiMate hierarchy, DAGs (default)" },
        { label: "mrtree",   val: "mrtree",   tooltip: "MR Tree — pure trees, org charts" },
        { label: "force",    val: "force",    tooltip: "Force-directed — exploratory, organic feel" },
        { label: "box",      val: "box",      tooltip: "Box packing — disconnected elements" },
        { label: "stress",   val: "stress",   tooltip: "Stress minimization — similar to force" },
        { label: "radial",   val: "radial",   tooltip: "Radial — circular tree from center root" },
        { label: "dagre",    val: "dagre",    tooltip: "Dagre (cluster-fix) — better cross-compound edge routing; use ranker param for network-simplex / tight-tree / longest-path" },
      ]);
      // Wire algorithm selection → enable/disable dependent controls
      let algoChildren = cAlgo.getChildren();
      for (let i = 0; i < algoChildren.length; i++) {
        if (algoChildren[i].getData('val') !== null) {
          algoChildren[i].addListener(SWT.Selection, function(e) {
            if (e.widget.getSelection()) layoutDialog.updateAlgoControls(e.widget.getData('val'));
          });
        }
      }

      // Direction row
      let cDir = new CompositeWidget(grpELK, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(5).applyTo(cDir);
      new LabelWidget(cDir, SWT.NONE).setText("Direction:");
      layoutDialog.widgets.grpDir = cDir;
      createRadios(cDir, [
        { label: "Right",  val: "RIGHT", tooltip: "Left to Right (default). With nesting: external neighbors appear left/right of container — use Down for above/below placement." },
        { label: "Down",   val: "DOWN",  tooltip: "Top to Bottom. Recommended for nested layouts: external neighbors appear above/below containers." },
        { label: "Up",     val: "UP",    tooltip: "Bottom to Top" },
        { label: "Left",   val: "LEFT",  tooltip: "Right to Left" },
      ]);

      // Node placement row — layered only: controls BRANDES_KOEPF fixedAlignment
      // This determines where the root lands vertically (top / center / bottom)
      let cAlign = new CompositeWidget(grpELK, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(5).applyTo(cAlign);
      new LabelWidget(cAlign, SWT.NONE).setText("Node placement:");
      layoutDialog.widgets.grpNodePlacement = cAlign;
      createRadios(cAlign, [
        { label: "Default",  val: "NONE",       tooltip: "Let the algorithm decide (default)" },
        { label: "Top",      val: "LEFTUP",     tooltip: "Align nodes upward — root tends to top-left" },
        { label: "Center",   val: "BALANCED",   tooltip: "Balance all alignment candidates — root tends to center-left" },
        { label: "Bottom",   val: "RIGHTDOWN",  tooltip: "Align nodes downward — root tends to bottom-left" },
      ]);

      // Edge Routing row
      let cRouting = new CompositeWidget(grpELK, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(4).applyTo(cRouting);
      new LabelWidget(cRouting, SWT.NONE).setText("Edge routing:");
      layoutDialog.widgets.grpEdgeRouting = cRouting;
      createRadios(cRouting, [
        { label: "Orthogonal", val: "ORTHOGONAL", tooltip: "Orthogonal — right-angle bends; best with layered. Edges within the same nested container are always drawn straight." },
        { label: "Polyline",   val: "POLYLINE",   tooltip: "Polyline — routed segments with bends; works well with all algorithms." },
        { label: "Straight",   val: "STRAIGHT",   tooltip: "Straight — direct line from source to target, no routing." },
      ]);

      // Note updated by updateAlgoControls to name ignored parameters for the active algorithm
      let lblAlgoNote = new LabelWidget(grpELK, SWT.WRAP);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(lblAlgoNote);
      layoutDialog.widgets.lblAlgoNote = lblAlgoNote;

      // Dimensions Group
      let grpDimensions = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(grpDimensions);
      grpDimensions.setText("Dimensions (pixels)");
      GridLayoutFactory.swtDefaults().numColumns(6).margins(10, 10).applyTo(grpDimensions);

      layoutDialog.createWidget("spinWidth", SpinnerWidget, grpDimensions, "Node Width:", null, function (w) {
        w.setValues(200, 10, 600, 0, 10, 50);
      });
      layoutDialog.createWidget("spinHeight", SpinnerWidget, grpDimensions, "Node Height:", null, function (w) {
        w.setValues(60, 10, 400, 0, 10, 20);
      });
      layoutDialog.createWidget(
        "spinNodeSep",
        SpinnerWidget,
        grpDimensions,
        "Node spacing:",
        "Space between nodes in the same rank (elk.spacing.nodeNode)",
        function (w) {
          w.setValues(40, 0, 600, 0, 10, 50);
        },
      );
      layoutDialog.createWidget(
        "spinLayerSep",
        SpinnerWidget,
        grpDimensions,
        "Layer spacing:",
        "Space between ranks/layers (elk.layered.spacing.nodeNodeBetweenLayers)",
        function (w) {
          w.setValues(180, 0, 600, 0, 10, 50);
        },
      );
      layoutDialog.createWidget(
        "spinPadding",
        SpinnerWidget,
        grpDimensions,
        "Nested padding:",
        "Padding inside nested (compound) containers",
        function (w) {
          w.setValues(20, 0, 100, 0, 5, 10);
        },
      );

      // Finalize Tab 1 scrolled composite
      scrolled1.setContent(layoutContainer);
      scrolled1.setMinSize(layoutContainer.computeSize(SWT.DEFAULT, SWT.DEFAULT));

      // --- TAB 2: Filtering ---
      let tabData = new TabItemWidget(tabFolder, SWT.NONE);
      tabData.setText("  Filtering  ");
      let dataContainer = new CompositeWidget(tabFolder, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).spacing(5, 5).applyTo(dataContainer);
      tabData.setControl(dataContainer);

      let grpElemFilter = new GroupWidget(dataContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpElemFilter);
      grpElemFilter.setText("Element filter");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpElemFilter);

      let lblElemDesc = new LabelWidget(grpElemFilter, SWT.NONE);
      lblElemDesc.setText("Element types that will be included in the view. Leave empty to include all elements.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblElemDesc);

      layoutDialog.createListBuilder(
        "lstElemTypes",
        grpElemFilter,
        null,
        null,
        View.ELEMENT_NAMES,
        layoutDialog.config.includeElementType,
      );

      let grpRelFilter = new GroupWidget(dataContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpRelFilter);
      grpRelFilter.setText("Relationship filter");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpRelFilter);

      let lblRelDesc = new LabelWidget(grpRelFilter, SWT.NONE);
      lblRelDesc.setText("Relationship types that will be included in the view. Leave empty to include all relationships.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblRelDesc);

      layoutDialog.createListBuilder(
        "lstRelTypes",
        grpRelFilter,
        null,
        null,
        View.RELATION_NAMES,
        layoutDialog.config.includeRelationType,
      );

      // --- TAB 3: Nesting and show reversed ---
      let tabRendering = new TabItemWidget(tabFolder, SWT.NONE);
      tabRendering.setText("  Nesting and show reversed  ");
      let rendContainer = new CompositeWidget(tabFolder, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(rendContainer);
      tabRendering.setControl(rendContainer);

      let grpNested = new GroupWidget(rendContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpNested);
      grpNested.setText("Nested");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpNested);
      let lblNestDesc = new LabelWidget(grpNested, SWT.NONE);
      lblNestDesc.setText("Relationship types rendered as nested parent/child boxes instead of lines.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblNestDesc);

      layoutDialog.createListBuilder("lstNested", grpNested, null, null, View.RELATION_NAMES, layoutDialog.config.layoutNested);

      // Multiple occurrences checkbox
      layoutDialog.createWidget(
        "chkMultiOcc",
        ButtonWidget,
        grpNested,
        null,
        "If checked: an element nested in multiple parents appears once in each parent container.\nIf unchecked (default): it appears only in the first parent.",
        function (w) {
          w.setText("Multiple occurrences — render element in each parent container   ");
          GridDataFactory.fillDefaults().span(2, 1).applyTo(w);
        },
        SWT.CHECK,
      );

      let grpReverse = new GroupWidget(rendContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpReverse);
      grpReverse.setText("Reverse");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpReverse);
      let lblRevDesc = new LabelWidget(grpReverse, SWT.NONE);
      lblRevDesc.setText("Relationship types to reverse visually in the graph structure.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblRevDesc);

      layoutDialog.createListBuilder(
        "lstReversed",
        grpReverse,
        null,
        null,
        View.RELATION_NAMES,
        layoutDialog.config.layoutReversed,
      );

      // --- TAB 4: Load and save ---
      let tabOutput = new TabItemWidget(tabFolder, SWT.NONE);
      tabOutput.setText("  Load and save  ");
      let outContainer = new CompositeWidget(tabFolder, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(outContainer);
      tabOutput.setControl(outContainer);

      let grpLoad = new GroupWidget(outContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpLoad);
      grpLoad.setText("Load Setup");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpLoad);

      let lblLoadDesc = new LabelWidget(grpLoad, SWT.NONE);
      lblLoadDesc.setText("Select a parameter preset file to instantly load its configured options.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblLoadDesc);

      let lstPresets = new ListWidget(grpLoad, SWT.SINGLE | SWT.BORDER | SWT.V_SCROLL);
      GridDataFactory.fillDefaults().grab(true, true).hint(SWT.DEFAULT, 150).span(1, 2).applyTo(lstPresets);
      let pFiles = getPresetFiles();
      pFiles.forEach((f) => lstPresets.add(f));

      let btnLoad = new ButtonWidget(grpLoad, SWT.PUSH);
      btnLoad.setText("Load Selected Preset");
      GridDataFactory.fillDefaults().align(SWT.FILL, SWT.BEGINNING).applyTo(btnLoad);
      btnLoad.addListener(SWT.Selection, function () {
        if (lstPresets.getSelectionIndex() >= 0) {
          layoutDialog.updateFromPreset(lstPresets.getSelection()[0]);
        }
      });

      let btnDel = new ButtonWidget(grpLoad, SWT.PUSH);
      btnDel.setText("Delete Selected Preset");
      GridDataFactory.fillDefaults().align(SWT.FILL, SWT.BEGINNING).applyTo(btnDel);
      btnDel.addListener(SWT.Selection, function () {
        let idx = lstPresets.getSelectionIndex();
        if (idx >= 0) {
          let fname = lstPresets.getSelection()[0];
          if (fname === "default_parameter.js") {
            window.alert("Cannot delete the default parameter file.");
            return;
          }
          if (window.confirm("Are you sure you want to delete preset: " + fname + "?")) {
            try {
              var fileToDelete = new java.io.File(__DIR__ + "user_parameter/" + fname);
              if (fileToDelete.exists()) {
                fileToDelete.delete();
                lstPresets.remove(idx);
              } else {
                window.alert("File not found: " + fname);
              }
            } catch (e) {
              window.alert("Error deleting file: " + e);
            }
          }
        }
      });

      let grpSave = new GroupWidget(outContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(grpSave);
      grpSave.setText("Save Current");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpSave);

      let lblSaveDesc = new LabelWidget(grpSave, SWT.NONE);
      lblSaveDesc.setText("Save your settings into a reusable parameter file.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblSaveDesc);

      let txtSaveName = new TextWidget(grpSave, SWT.BORDER);
      txtSaveName.setMessage("Enter new parameter file name...");
      GridDataFactory.fillDefaults().grab(true, false).applyTo(txtSaveName);

      let btnSave = new ButtonWidget(grpSave, SWT.PUSH);
      btnSave.setText("Save to User Parameters");
      btnSave.addListener(SWT.Selection, function () {
        let fname = txtSaveName.getText();
        if (fname.trim() !== "") {
          layoutDialog.saveInput();
          writePreset(fname, layoutDialog.config);
          lstPresets.removeAll();
          getPresetFiles().forEach((f) => lstPresets.add(f));
          window.alert("Preset saved to user_parameter/" + fname + (fname.endsWith(".js") ? "" : ".js"));
        }
      });

      layoutDialog.createWidget(
        "chkDebug",
        ButtonWidget,
        outContainer,
        null,
        "Print debug logs to console",
        function (w) {
          w.setText("Execute with Debug Trace   ");
        },
        SWT.CHECK,
      );

      layoutDialog.syncConfigToUI();

      return area;
    },

    okPressed: function () {
      layoutDialog.saveInput();
      Java.super(layoutDialog.dialog).okPressed();
    },
  }),
};

const OK = layoutDialog.open();

if (!OK) {
  console.log("Operation cancelled.");
  exit();
}

writeJSON(LAST_RUN_FILE, layoutDialog.config);

View.generate_view(layoutDialog.config, initialSelection);
Common.finishConsoleLog();
