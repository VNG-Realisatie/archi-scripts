/**
 * Interactive Graphical User Interface for View Layout Parameters
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common");

Common.initConsoleLog(__FILE__, true);

const View = require(REPO_ROOT + "View/include_view");
const File = Java.type("java.io.File");
const FileWriter = Java.type("java.io.FileWriter");
const FileReader = Java.type("java.io.FileReader");
const BufferedReader = Java.type("java.io.BufferedReader");

// Capture selection before opening the SWT dialog causes focus loss
const initialSelection = $(selection);

const SWT = Java.type("org.eclipse.swt.SWT");
const LabelWidget = Java.type("org.eclipse.swt.widgets.Label");
const CompositeWidget = Java.type("org.eclipse.swt.widgets.Composite");
const SpinnerWidget = Java.type("org.eclipse.swt.widgets.Spinner");
const GroupWidget = Java.type("org.eclipse.swt.widgets.Group");
const ButtonWidget = Java.type("org.eclipse.swt.widgets.Button");
const ComboWidget = Java.type("org.eclipse.swt.widgets.Combo");
const TabFolderWidget = Java.type("org.eclipse.swt.widgets.TabFolder");
const TabItemWidget = Java.type("org.eclipse.swt.widgets.TabItem");
const ScrolledCompositeWidget = Java.type("org.eclipse.swt.custom.ScrolledComposite");
const TextWidget = Java.type("org.eclipse.swt.widgets.Text");
const ListWidget = Java.type("org.eclipse.swt.widgets.List");
const TableWidget = Java.type("org.eclipse.swt.widgets.Table");
const TableColumnWidget = Java.type("org.eclipse.swt.widgets.TableColumn");
const TableItemWidget = Java.type("org.eclipse.swt.widgets.TableItem");
const TableEditorWidget = Java.type("org.eclipse.swt.custom.TableEditor");
const SWTPoint = Java.type("org.eclipse.swt.graphics.Point");
const TextLayout = Java.type("org.eclipse.swt.graphics.TextLayout");
const GridDataFactory = Java.type("org.eclipse.jface.layout.GridDataFactory");
const GridLayoutFactory = Java.type("org.eclipse.jface.layout.GridLayoutFactory");
const TitleAreaDialog = Java.type("org.eclipse.jface.dialogs.TitleAreaDialog");
const IMessageProvider = Java.type("org.eclipse.jface.dialogs.IMessageProvider");

// Helper to list parameter files
function getPresetFiles() {
  var dir = new File(__DIR__ + "user_parameter");
  var files = dir.listFiles();
  var names = [];
  if (files) {
    for (var i = 0; i < files.length; i++) {
      if (files[i].isFile() && files[i].getName().endsWith(".js")) {
        names.push(files[i].getName());
      }
    }
  }
  return names;
}

// Interacting with File system natively to avoid Node.js limitations
function writeJSON(path, obj) {
  try {
    var writer = new FileWriter(path);
    writer.write(JSON.stringify(obj, null, 2));
    writer.close();
  } catch (e) {
    console.error("Failed to write state:", e);
  }
}

function readJSON(path) {
  try {
    var reader = new BufferedReader(new FileReader(path));
    var line = "";
    var content = "";
    while ((line = reader.readLine()) != null) content += line;
    reader.close();
    return JSON.parse(content);
  } catch (e) {
    return null;
  }
}

function writePreset(filename, obj) {
  if (!filename.endsWith(".js")) filename += ".js";
  var path = __DIR__ + "user_parameter/" + filename;
  var writer = new FileWriter(path);
  writer.write("/**\n * Saved from _GUI.ajs\n */\n\nmodule.exports = " + JSON.stringify(obj, null, 2) + ";\n");
  writer.close();
}

function readPresetObj(filename) {
  var path = __DIR__ + "user_parameter/" + filename;
  try {
    var reader = new BufferedReader(new FileReader(path));
    var line, content = "";
    while ((line = reader.readLine()) != null) content += line + "\n";
    reader.close();
    var idx = content.indexOf("module.exports = ");
    if (idx >= 0) {
      var jsonStr = content.substring(idx + "module.exports = ".length).replace(/;\s*[\n\r]*$/, "").trim();
      try { return JSON.parse(jsonStr); } catch(ignored) {}
    }
  } catch(e) {}
  try { return require(path); } catch(e) { return null; }
}

// Determine defaults
const LAST_RUN_FILE = __DIR__ + ".last_gui_run_params.json";
let defaultParams = readJSON(LAST_RUN_FILE);

if (!defaultParams) {
  try {
    defaultParams = require(__DIR__ + "user_parameter/default_parameter.js");
  } catch (e) {
    defaultParams = {
      action: View.GENERATE_SINGLE,
      graphDepth: 1,
      includeElementType: [],
      includeRelationType: [],
      excludeFromView: false,
      layoutReversed: [],
      layoutNested: [],
      nestingMultipleOccurrences: false,
      viewName: "",
      viewNameSuffix: "",
      viewFolder: "",
      elkAlgorithm:       View.DEFAULT_ELK_ALGORITHM,
      elkDirection:       View.DEFAULT_ELK_DIRECTION,
      elkSpacingNodeNode: View.DEFAULT_ELK_SPACING,
      elkLayerSpacing:    View.DEFAULT_ELK_LAYER_SEP,
      elkEdgeRouting:     View.DEFAULT_ELK_EDGE_ROUTING,
      elkPadding:         View.DEFAULT_ELK_PADDING,
      elkNestedAlgorithm: "",
      elkNestedSpacingNodeNode: 10,
      elkNestedExpandToFill: false,
      dagreRanker:        "network-simplex",
      useRelationWeights: false,
      nodeWidth:  200,
      nodeHeight: 60,
      debug: false,
    };
  }
}

const ConfigDialog = Java.extend(TitleAreaDialog);

let layoutDialog = {
  config: defaultParams,
  widgets: {},

  createWidget: function (name, widgetClass, container, label, tooltip, init, flags) {
    if (flags === undefined) flags = SWT.BORDER;

    if (label != null) {
      let txt = new LabelWidget(container, SWT.NONE);
      txt.setText(label);
      if (tooltip) txt.setToolTipText(tooltip);
      if (name != null) this.widgets[name + '_lbl'] = txt;
    }

    let widget = new widgetClass(container, flags);
    if (tooltip) widget.setToolTipText(tooltip);
    if (init != null) init(widget);
    if (name != null) this.widgets[name] = widget;

    return widget;
  },

  createListBuilder: function (name, container, label, tooltip, availableItems, initialSelected) {
    if (label != null) {
      let txt = new LabelWidget(container, SWT.NONE);
      txt.setText(label);
      if (tooltip) txt.setToolTipText(tooltip);
      GridDataFactory.fillDefaults().span(2, 1).applyTo(txt);
    }

    let mainComp = new CompositeWidget(container, SWT.NONE);
    GridDataFactory.fillDefaults().grab(true, true).span(2, 1).applyTo(mainComp);
    GridLayoutFactory.swtDefaults().numColumns(3).margins(0, 0).applyTo(mainComp);

    // Left: Search + Available
    let leftComp = new CompositeWidget(mainComp, SWT.NONE);
    GridDataFactory.fillDefaults().grab(true, true).applyTo(leftComp);
    GridLayoutFactory.swtDefaults().numColumns(1).margins(0, 0).applyTo(leftComp);

    let txtSearch = new TextWidget(leftComp, SWT.BORDER | SWT.SEARCH | SWT.ICON_SEARCH | SWT.ICON_CANCEL);
    txtSearch.setMessage("Type to search...");
    GridDataFactory.fillDefaults().grab(true, false).applyTo(txtSearch);

    let lstAvailable = new ListWidget(leftComp, SWT.BORDER | SWT.V_SCROLL);
    GridDataFactory.fillDefaults().grab(true, true).hint(SWT.DEFAULT, 100).applyTo(lstAvailable);
    if (name != null) this.widgets[name + "_avail"] = lstAvailable;

    function updateAvailable() {
      lstAvailable.removeAll();
      let q = txtSearch.getText().toLowerCase();
      availableItems.forEach(function (item) {
        if (item.toLowerCase().indexOf(q) >= 0) {
          lstAvailable.add(item);
        }
      });
    }
    updateAvailable();

    txtSearch.addListener(SWT.Modify, function () {
      updateAvailable();
    });

    // Middle: Buttons
    let btnComp = new CompositeWidget(mainComp, SWT.NONE);
    GridDataFactory.fillDefaults().align(SWT.CENTER, SWT.CENTER).applyTo(btnComp);
    GridLayoutFactory.swtDefaults().numColumns(1).margins(5, 0).applyTo(btnComp);

    let btnAdd = new ButtonWidget(btnComp, SWT.PUSH);
    btnAdd.setText("Add >");
    GridDataFactory.fillDefaults().hint(95, SWT.DEFAULT).applyTo(btnAdd);

    let btnRemove = new ButtonWidget(btnComp, SWT.PUSH);
    btnRemove.setText("< Remove");
    GridDataFactory.fillDefaults().hint(95, SWT.DEFAULT).applyTo(btnRemove);

    // Right: Selected
    let rightComp = new CompositeWidget(mainComp, SWT.NONE);
    GridDataFactory.fillDefaults().grab(true, true).applyTo(rightComp);
    GridLayoutFactory.swtDefaults().numColumns(1).margins(0, 0).applyTo(rightComp);

    let lblSelected = new LabelWidget(rightComp, SWT.NONE);
    lblSelected.setText("Active selection — double-click to remove:");

    let lstSelected = new ListWidget(rightComp, SWT.BORDER | SWT.V_SCROLL | SWT.MULTI);
    GridDataFactory.fillDefaults().grab(true, true).hint(SWT.DEFAULT, 100).applyTo(lstSelected);

    function applySelection() {
      let sel = lstAvailable.getSelection();
      if (sel.length === 0) {
        let q = txtSearch.getText().trim();
        if (q !== "" && q !== "Type to search...") sel = [q];
      }
      for (let i = 0; i < sel.length; i++) {
        let has = false;
        for (let j = 0; j < lstSelected.getItemCount(); j++) {
          if (lstSelected.getItem(j) === sel[i]) has = true;
        }
        if (!has) lstSelected.add(sel[i]);
      }
      txtSearch.setText(""); // clear search
    }

    function removeSelection() {
      let indices = lstSelected.getSelectionIndices();
      lstSelected.remove(indices);
    }

    btnAdd.addListener(SWT.Selection, applySelection);
    lstAvailable.addListener(SWT.MouseDoubleClick, applySelection);
    txtSearch.addListener(SWT.DefaultSelection, applySelection); // Enter key

    btnRemove.addListener(SWT.Selection, removeSelection);
    lstSelected.addListener(SWT.MouseDoubleClick, removeSelection);

    // Save references for data extraction and enable/disable
    this.widgets[name]           = lstSelected;
    if (name != null) this.widgets[name + "_comp"] = mainComp;

    // Initialize values
    if (initialSelected && initialSelected.length > 0) {
      initialSelected.forEach(function (item) {
        lstSelected.add(item);
      });
    }
  },

  promptPresetReview: function (presetName, newConfig) {
    let diffs = [];

    // mapping for human readability
    let map = {
      action:                 "Action",
      graphDepth:             "Relation levels",
      includeElementType:     "Element types",
      includeRelationType:    "Relationship types",
      excludeFromView:        "Respect excluded relations",
      layoutReversed:         "Reversed relationships",
      layoutNested:           "Nested relationships",
      nestingMultipleOccurrences: "Show in every container",
      viewName:               "View Name",
      viewNameSuffix:         "View Suffix",
      viewFolder:             "View Folder",
      elkAlgorithm:           "Layout style",
      dagreRanker:            "Layer ranking",
      elkDirection:           "Flow direction",
      elkEdgeRouting:         "Relation style",
      elkSpacingNodeNode:     "Element spacing",
      elkLayerSpacing:        "Level spacing",
      elkPadding:             "Container padding",
      elkNestedAlgorithm:         "Pack containers tightly",
      elkNestedSpacingNodeNode:   "Child spacing",
      elkNestedExpandToFill:      "Equal row height",
      useRelationWeights:     "Relation weights",
      nodeWidth:              "Element width",
      nodeHeight:             "Element height",
      debug:                  "Console log",
    };

    Object.keys(newConfig).forEach((k) => {
      let oldVal = this.config[k];
      let newVal = newConfig[k];
      let oldStr = Array.isArray(oldVal) ? oldVal.join(", ") : String(oldVal);
      let newStr = Array.isArray(newVal) ? newVal.join(", ") : String(newVal);

      if (oldStr !== newStr) {
        diffs.push({
          key: map[k] || k,
          oldV: oldStr ? oldStr : "(empty)",
          newV: newStr ? newStr : "(empty)",
        });
      }
    });

    if (diffs.length === 0) {
      window.alert("Preset '" + presetName + "' is identical to your current settings.");
      return false;
    }

    let ReviewDialogClass = Java.extend(TitleAreaDialog);
    let okPressed = false;

    let dlg = new ReviewDialogClass(shell, {
      create: function () {
        Java.super(dlg).create();
        dlg.setTitle("Review Preset: " + presetName);
        dlg.setMessage("The following settings will change when this preset is applied.", IMessageProvider.INFORMATION);
        dlg.getShell().setSize(700, 500);
        dlg.getShell().setText("Preset Review");
      },
      createDialogArea: function (parent) {
        let area = Java.super(dlg).createDialogArea(parent);
        let container = new CompositeWidget(area, SWT.NONE);
        GridDataFactory.fillDefaults().grab(true, true).applyTo(container);
        GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(container);

        let table = new org.eclipse.swt.widgets.Table(container, SWT.BORDER | SWT.FULL_SELECTION | SWT.V_SCROLL);
        table.setHeaderVisible(true);
        table.setLinesVisible(true);
        GridDataFactory.fillDefaults().grab(true, true).applyTo(table);

        let col1 = new org.eclipse.swt.widgets.TableColumn(table, SWT.NONE);
        col1.setText("Setting");
        col1.setWidth(150);

        let col2 = new org.eclipse.swt.widgets.TableColumn(table, SWT.NONE);
        col2.setText("Current");
        col2.setWidth(250);

        let col3 = new org.eclipse.swt.widgets.TableColumn(table, SWT.NONE);
        col3.setText("Preset");
        col3.setWidth(250);

        let TableItem = Java.type("org.eclipse.swt.widgets.TableItem");
        diffs.forEach((d) => {
          let item = new TableItem(table, SWT.NONE);
          item.setText(0, d.key);
          item.setText(1, d.oldV);
          item.setText(2, d.newV);
        });

        return area;
      },
      isResizable: function () {
        return true;
      },
      createButtonsForButtonBar: function (parent) {
        let IDialogConstants = Java.type("org.eclipse.jface.dialogs.IDialogConstants");
        Java.super(dlg).createButton(parent, IDialogConstants.OK_ID, "Apply Changes", true);
        Java.super(dlg).createButton(parent, IDialogConstants.CANCEL_ID, IDialogConstants.CANCEL_LABEL, false);
      },
      okPressed: function () {
        okPressed = true;
        Java.super(dlg).okPressed();
      },
    });

    dlg.open();
    return okPressed;
  },

  openPresetManager: function (shell) {
    let ManagerClass = Java.extend(TitleAreaDialog);
    let mgr = new ManagerClass(shell, {
      create: function () {
        Java.super(mgr).create();
        mgr.setTitle("Manage Presets");
        mgr.setMessage("Click the description cell to edit it inline. Ctrl+Enter to confirm.", IMessageProvider.INFORMATION);
        mgr.getShell().setSize(820, 580);
        mgr.getShell().setText("Manage Presets");
      },
      createDialogArea: function (parent) {
        let area = Java.super(mgr).createDialogArea(parent);
        let cont = new CompositeWidget(area, SWT.NONE);
        GridDataFactory.fillDefaults().grab(true, true).applyTo(cont);
        GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(cont);

        let tbl = new TableWidget(cont, SWT.SINGLE | SWT.BORDER | SWT.FULL_SELECTION | SWT.V_SCROLL);
        tbl.setHeaderVisible(true);
        tbl.setLinesVisible(true);
        GridDataFactory.fillDefaults().grab(true, true).span(1, 2).applyTo(tbl);

        let colN = new TableColumnWidget(tbl, SWT.NONE);
        colN.setText("Preset");
        let colD = new TableColumnWidget(tbl, SWT.NONE);
        colD.setText("Description — click to edit");

        tbl.addListener(SWT.Resize, function () {
          let w = tbl.getClientArea().width;
          let nw = Math.min(200, Math.floor(w * 0.35));
          colN.setWidth(nw); colD.setWidth(w - nw);
        });

        function refreshTbl() {
          tbl.removeAll();
          getPresetFiles().forEach(function (f) {
            let row = new TableItemWidget(tbl, SWT.NONE);
            row.setText(0, f);
            let obj = readPresetObj(f);
            row.setText(1, obj && obj.doc ? obj.doc : "");
          });
        }
        refreshTbl();

        let tblEd = new TableEditorWidget(tbl);
        tblEd.horizontalAlignment = SWT.LEFT;
        tblEd.grabHorizontal = true;
        tblEd.minimumWidth = 50;

        tbl.addListener(SWT.MouseDown, function (event) {
          let item = tbl.getItem(new SWTPoint(event.x, event.y));
          if (!item || event.x < colN.getWidth()) return;
          let prev = tblEd.getEditor();
          if (prev && !prev.isDisposed()) prev.dispose();
          let txtEd = new TextWidget(tbl, SWT.MULTI | SWT.WRAP);
          txtEd.setText(String(item.getText(1)));
          tblEd.setEditor(txtEd, item, 1);
          tbl.getDisplay().asyncExec(function () {
            if (!txtEd.isDisposed()) { txtEd.setFocus(); txtEd.setSelection(0, 0); }
          });
          function commit() {
            if (txtEd.isDisposed()) return;
            let newDoc = txtEd.getText().trim();
            item.setText(1, newDoc);
            txtEd.dispose();
            let obj = readPresetObj(String(item.getText(0)));
            if (obj) { if (newDoc) obj.doc = newDoc; else delete obj.doc; writePreset(String(item.getText(0)), obj); }
          }
          txtEd.addListener(SWT.FocusOut, function () { commit(); });
          txtEd.addListener(SWT.Traverse, function (ev) {
            if (ev.detail === SWT.TRAVERSE_ESCAPE) { txtEd.dispose(); ev.doit = false; }
            else if (ev.detail === SWT.TRAVERSE_RETURN && (ev.stateMask & SWT.CTRL) !== 0) { commit(); ev.doit = false; }
          });
        });

        let btnDel = new ButtonWidget(cont, SWT.PUSH);
        btnDel.setText("Delete");
        GridDataFactory.fillDefaults().align(SWT.FILL, SWT.BEGINNING).applyTo(btnDel);
        btnDel.addListener(SWT.Selection, function () {
          let sel = tbl.getSelection();
          if (!sel.length) return;
          let fname = String(sel[0].getText(0));
          if (fname === "default_parameter.js") { window.alert("Cannot delete the default preset."); return; }
          if (window.confirm("Delete: " + fname + "?")) {
            let jf = new java.io.File(__DIR__ + "user_parameter/" + fname);
            if (jf.exists()) { jf.delete(); tbl.remove(tbl.getSelectionIndex()); }
          }
        });

        new LabelWidget(cont, SWT.NONE); // filler — keeps Delete top-aligned
        return area;
      },
      isResizable: function () { return true; },
      createButtonsForButtonBar: function (parent) {
        let IDC = Java.type("org.eclipse.jface.dialogs.IDialogConstants");
        Java.super(mgr).createButton(parent, IDC.OK_ID, "Close", true);
      },
      okPressed: function () { Java.super(mgr).okPressed(); },
    });
    mgr.open();
  },

  updateFromPreset: function (presetName) {
    try {
      let newCfg = require(__DIR__ + "user_parameter/" + presetName);

      if (this.promptPresetReview(presetName, newCfg)) {
        Object.keys(newCfg).forEach((k) => {
          if (k !== "doc") this.config[k] = newCfg[k];
        });
        this.syncConfigToUI();
      }
    } catch (e) {
      console.error("Could not load preset " + presetName, e);
      window.alert("Error loading preset: " + e);
    }
  },

  syncConfigToUI: function () {
    let setRadio = (group, val) => {
      let children = group.getChildren();
      let hasSelection = false;
      let firstRadio = null;
      for (let i = 0; i < children.length; i++) {
        let dataVal = children[i].getData("val");
        if (dataVal !== null && dataVal !== undefined) {
          if (!firstRadio) firstRadio = children[i];
          if (dataVal === val) {
            children[i].setSelection(true);
            hasSelection = true;
          } else {
            children[i].setSelection(false);
          }
        }
      }
      if (!hasSelection && firstRadio !== null) {
        firstRadio.setSelection(true);
      }
    };

    let setBuilder = (wList, arr) => {
      wList.removeAll();
      if (!arr || !arr.length) return;
      arr.forEach((item) => wList.add(item));
    };

    if (this.widgets.grpActionControls) {
      setRadio(this.widgets.grpActionControls, this.config.action);
      if (layoutDialog._updateActionColors) layoutDialog._updateActionColors();
      this.updateActionControls(this.config.action);
    }
    if (this.config.graphDepth !== undefined) this.widgets.spinDepth.setSelection(this.config.graphDepth);

    setBuilder(this.widgets.lstElemTypes, this.config.includeElementType);
    // Sync relation filter fixed grid [Option C]
    (this.widgets._relTypeRows || []).forEach(row => {
      let dir = null;
      (this.config.includeRelationType || []).forEach(entry => {
        let ci = entry.indexOf(":");
        if ((ci >= 0 ? entry.substring(0, ci) : entry) === row.type)
          dir = ci >= 0 ? entry.substring(ci + 1) : "both";
      });
      let on = dir !== null;
      row.chk.setSelection(on);
      row.rdoIn.setSelection(dir === "in");
      row.rdoOut.setSelection(dir === "out");
      row.rdoIn.setEnabled(on); row.rdoOut.setEnabled(on);
      if (row.updateDirColors) row.updateDirColors();
    });

    if (this.widgets.grpAlgorithm) {
      setRadio(this.widgets.grpAlgorithm, this.config.elkAlgorithm || View.DEFAULT_ELK_ALGORITHM);
      this.updateAlgoControls(this.config.elkAlgorithm || View.DEFAULT_ELK_ALGORITHM);
    }
    if (this.widgets.grpDir)         setRadio(this.widgets.grpDir,         this.config.elkDirection    || View.DEFAULT_ELK_DIRECTION);
    if (this.widgets.grpEdgeRouting) setRadio(this.widgets.grpEdgeRouting, this.config.elkEdgeRouting  || View.DEFAULT_ELK_EDGE_ROUTING);
    if (this.widgets.grpRanker)      setRadio(this.widgets.grpRanker,      this.config.dagreRanker     || "network-simplex");

    if (this.config.nodeWidth)          this.widgets.spinWidth.setSelection(this.config.nodeWidth);
    if (this.config.nodeHeight)         this.widgets.spinHeight.setSelection(this.config.nodeHeight);
    if (this.config.elkSpacingNodeNode) this.widgets.spinNodeSep.setSelection(this.config.elkSpacingNodeNode);
    if (this.config.elkLayerSpacing)    this.widgets.spinLayerSep.setSelection(this.config.elkLayerSpacing);
    if (this.config.elkPadding !== undefined) this.widgets.spinPadding.setSelection(this.config.elkPadding);

    (this.widgets.lstReversed_checks || []).forEach(r => r.chk.setSelection((this.config.layoutReversed || []).indexOf(r.type) >= 0));
    (this.widgets.lstNested_checks   || []).forEach(r => r.chk.setSelection((this.config.layoutNested   || []).indexOf(r.type) >= 0));

    if (this.widgets.chkUseWeights)        this.widgets.chkUseWeights.setSelection(!!this.config.useRelationWeights);
    if (this.widgets.chkMultiOcc)          this.widgets.chkMultiOcc.setSelection(!!this.config.nestingMultipleOccurrences);
    if (this.widgets.chkNestedPack) {
      this.widgets.chkNestedPack.setSelection(this.config.elkNestedAlgorithm === "rectpacking");
      if (this.widgets.spinNestedSpacing)
        this.widgets.spinNestedSpacing.setSelection(this.config.elkNestedSpacingNodeNode !== undefined ? this.config.elkNestedSpacingNodeNode : 10);
      if (this.widgets.chkExpandToFill)
        this.widgets.chkExpandToFill.setSelection(!!this.config.elkNestedExpandToFill);
      if (this.widgets.lstExpandExclude)
        setBuilder(this.widgets.lstExpandExclude, this.config.elkExpandExcludeTypes || []);
      if (layoutDialog._updatePackControls) layoutDialog._updatePackControls();
    }
    if (this.widgets.chkSortLeavesOnly)  this.widgets.chkSortLeavesOnly.setSelection(!!this.config.elkSortLeavesOnly);
    if (this.widgets.chkExcludeFromView)   this.widgets.chkExcludeFromView.setSelection(!!this.config.excludeFromView);

    if (initialSelection && initialSelection.length > 0) {
      let firstObj = initialSelection.first();
      if (firstObj && firstObj.name) {
        this.widgets.txtViewName.setText(firstObj.name);
      } else {
        this.widgets.txtViewName.setText("");
      }
    } else {
      this.widgets.txtViewName.setText("");
    }

    if (this.widgets.chkDebug && this.config.debug !== undefined) this.widgets.chkDebug.setSelection(this.config.debug);
  },

  saveInput: function () {
    let getRadioVal = (group) => {
      let children = group.getChildren();
      for (let i = 0; i < children.length; i++) {
        let dataVal = children[i].getData("val");
        if (dataVal !== null && dataVal !== undefined && typeof children[i].getSelection === "function") {
          if (children[i].getSelection()) {
            return dataVal;
          }
        }
      }
      return undefined;
    };

    this.config.action = getRadioVal(this.widgets.grpActionControls);
    if (this.config.action === "None") this.config.action = undefined;

    this.config.graphDepth      = this.widgets.spinDepth.getSelection();
    this.config.excludeFromView = this.widgets.chkExcludeFromView ? this.widgets.chkExcludeFromView.getSelection() : false;

    let toJsArray = (wList) => {
      let res = [];
      let items = wList.getItems();
      if (items) {
        for (let i = 0; i < items.length; i++) res.push(String(items[i]));
      }
      return res;
    };

    this.config.includeElementType  = toJsArray(this.widgets.lstElemTypes);
    this.config.includeRelationType = (this.widgets._relTypeRows || [])
      .filter(r => r.chk.getSelection())
      .map(r => {
        let inOn = r.rdoIn.getSelection(), outOn = r.rdoOut.getSelection();
        if (inOn && !outOn) return r.type + ":in";
        if (outOn && !inOn) return r.type + ":out";
        return r.type; // neither or both = both directions
      });

    this.config.elkAlgorithm       = getRadioVal(this.widgets.grpAlgorithm);
    this.config.elkDirection        = getRadioVal(this.widgets.grpDir);
    this.config.elkEdgeRouting      = getRadioVal(this.widgets.grpEdgeRouting);
    this.config.dagreRanker         = this.widgets.grpRanker ? (getRadioVal(this.widgets.grpRanker) || "network-simplex") : "network-simplex";
    this.config.useRelationWeights  = this.widgets.chkUseWeights ? this.widgets.chkUseWeights.getSelection() : false;

    this.config.nodeWidth           = this.widgets.spinWidth.getSelection();
    this.config.nodeHeight          = this.widgets.spinHeight.getSelection();
    this.config.elkSpacingNodeNode  = this.widgets.spinNodeSep.getSelection();
    this.config.elkLayerSpacing     = this.widgets.spinLayerSep.getSelection();
    this.config.elkPadding          = this.widgets.spinPadding.getSelection();

    this.config.layoutReversed = (this.widgets.lstReversed_checks || []).filter(r => r.chk.getSelection()).map(r => r.type);
    this.config.layoutNested   = (this.widgets.lstNested_checks   || []).filter(r => r.chk.getSelection()).map(r => r.type);
    this.config.nestingMultipleOccurrences = this.widgets.chkMultiOcc.getSelection();
    this.config.elkNestedAlgorithm       = (this.widgets.chkNestedPack && this.widgets.chkNestedPack.getSelection()) ? "rectpacking" : "";
    this.config.elkNestedSpacingNodeNode = this.widgets.spinNestedSpacing ? this.widgets.spinNestedSpacing.getSelection() : 10;
    this.config.elkNestedExpandToFill    = !!(this.widgets.chkExpandToFill    && this.widgets.chkExpandToFill.getSelection());
    this.config.elkExpandExcludeTypes    = toJsArray(this.widgets.lstExpandExclude);
    this.config.elkSortLeavesOnly        = !!(this.widgets.chkSortLeavesOnly && this.widgets.chkSortLeavesOnly.getSelection());

    this.config.viewName       = String(this.widgets.txtViewName.getText()).trim();
    this.config.viewNameSuffix = undefined;
    this.config.viewFolder     = undefined;

    this.config.debug = this.widgets.chkDebug.getSelection();
  },

  updateActionControls: function (action) {
    const depthApplies = (action !== View.LAYOUT);
    const nameApplies  = (action === View.GENERATE_SINGLE);
    if (this.widgets.spinDepth)       this.widgets.spinDepth.setEnabled(depthApplies);
    if (this.widgets.spinDepth_lbl)   this.widgets.spinDepth_lbl.setEnabled(depthApplies);
    if (this.widgets.txtViewName)     this.widgets.txtViewName.setEnabled(nameApplies);
    if (this.widgets.txtViewName_lbl) this.widgets.txtViewName_lbl.setEnabled(nameApplies);
  },

  updateAlgoControls: function (algo) {
    if (!this.widgets.grpDir) return;
    var CAPS = {
      layered:     { dir: true,  routing: true,  layerSep: true,  ranker: false, weights: false },
      mrtree:      { dir: true,  routing: true,  layerSep: true,  ranker: false, weights: false },
      force:       { dir: false, routing: false, layerSep: false, ranker: false, weights: true  },
      box:         { dir: false, routing: false, layerSep: false, ranker: false, weights: false },
      stress:      { dir: false, routing: false, layerSep: false, ranker: false, weights: true  },
      radial:      { dir: false, routing: false, layerSep: true,  ranker: false, weights: true  },
      dagre:       { dir: true,  routing: false, layerSep: true,  ranker: true,  weights: false },
      rectpacking: { dir: false, routing: false, layerSep: false, ranker: false, weights: false },
    };
    var c = CAPS[algo] || CAPS['layered'];
    function setRowEnabled(comp, enabled) {
      var ch = comp.getChildren();
      for (var i = 0; i < ch.length; i++) ch[i].setEnabled(enabled);
    }
    setRowEnabled(this.widgets.grpDir,           c.dir);
    setRowEnabled(this.widgets.grpEdgeRouting,    c.routing);
    if (this.widgets.grpRanker)        setRowEnabled(this.widgets.grpRanker, c.ranker);
    if (this.widgets.chkUseWeights)    this.widgets.chkUseWeights.setEnabled(c.weights);
    if (this.widgets.spinLayerSep)     this.widgets.spinLayerSep.setEnabled(c.layerSep);
    if (this.widgets.spinLayerSep_lbl) this.widgets.spinLayerSep_lbl.setEnabled(c.layerSep);
  },

  open: function () {
    return this.dialog.open() == 0;
  },

  dialog: new ConfigDialog(shell, {
    create: function () {
      Java.super(layoutDialog.dialog).create();
      layoutDialog.dialog.setTitle("View generation and layout");
      layoutDialog.dialog.setMessage(
        "Configure how the view is built and how elements are arranged.",
        IMessageProvider.INFORMATION,
      );
      let _sh = layoutDialog.dialog.getShell();
      let _ca = _sh.getMonitor().getClientArea();
      _sh.pack();
      _sh.setSize(_sh.getSize().x, Math.min(1080, _ca.height - 40));
      // Re-apply toggle colors after the first paint (GTK needs this)
      _sh.getDisplay().asyncExec(function() {
        if (layoutDialog._updateActionColors) layoutDialog._updateActionColors();
        (layoutDialog.widgets._relTypeRows || []).forEach(function(row) {
          if (row.updateDirColors) row.updateDirColors();
        });
      });
    },

    createDialogArea: function (parent) {
      let area = Java.super(layoutDialog.dialog).createDialogArea(parent);

      let container = new CompositeWidget(area, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(container);
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(container);

      // ── Row 1: Action — flat toggle bar, no group border ────────────────────
      let compAction = new CompositeWidget(container, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(compAction);
      GridLayoutFactory.swtDefaults().numColumns(5).margins(2, 4).spacing(4, 0).applyTo(compAction);
      layoutDialog.widgets.grpActionControls = compAction;

      let lblGenerate = new LabelWidget(compAction, SWT.NONE);
      lblGenerate.setText("Generate:");

      (function() {
        let actions = [
          { label: "New view",     val: View.GENERATE_SINGLE,   tip: "Creates or updates a single view from the selected elements and their relations." },
          { label: "Per element",  val: View.GENERATE_MULTIPLE, tip: "Creates a separate view for each selected element. The view name will be the element's name." },
          { label: "Expand",       val: View.EXPAND_HERE,        tip: "Adds related elements to the current view. Select one or more elements in the view to expand their relations. Existing elements are kept." },
          { label: "Layout only",  val: View.LAYOUT,             tip: "Re-arranges all elements and relations on the selected current view. Nothing is added or removed." },
        ];
        actions.forEach(function(a) {
          let btn = new ButtonWidget(compAction, SWT.TOGGLE);
          btn.setText("  " + a.label + "  ");
          btn.setData("val", a.val);
          btn.setToolTipText(a.tip);
          btn.addListener(SWT.Selection, function() {
            if (btn.getSelection()) {
              let ch = compAction.getChildren();
              for (let i = 0; i < ch.length; i++) {
                if (ch[i] !== btn && typeof ch[i].setSelection === "function") ch[i].setSelection(false);
              }
              layoutDialog._updateActionColors();
              layoutDialog.updateActionControls(a.val);
            } else {
              btn.setSelection(true); // always keep one active
              layoutDialog._updateActionColors();
            }
          });
        });

        layoutDialog._updateActionColors = function() {
          let display = compAction.getDisplay();
          let white  = display.getSystemColor(SWT.COLOR_WHITE);
          let defBg  = display.getSystemColor(SWT.COLOR_WIDGET_BACKGROUND);
          let ch = compAction.getChildren();
          for (let i = 0; i < ch.length; i++) {
            if (typeof ch[i].getSelection === "function")
              ch[i].setBackground(ch[i].getSelection() ? white : defBg);
          }
        };
      })();

      // ── Row 2: View name + Relation levels ───────────────────────────────────
      let compViewFields = new CompositeWidget(container, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(compViewFields);
      GridLayoutFactory.swtDefaults().numColumns(4).margins(2, 0).spacing(20, 0).applyTo(compViewFields);

      let lblViewNameLbl = new LabelWidget(compViewFields, SWT.NONE);
      lblViewNameLbl.setText("View name:");
      layoutDialog.widgets.txtViewName_lbl = lblViewNameLbl;
      let txtViewNameWidget = new TextWidget(compViewFields, SWT.BORDER);
      txtViewNameWidget.setToolTipText("The name of the view to create or update.\nLeave blank to use the name of the first selected element.\nOnly used by 'New view'.");
      GridDataFactory.fillDefaults().grab(true, false).applyTo(txtViewNameWidget);
      layoutDialog.widgets.txtViewName = txtViewNameWidget;

      let lblDepthLbl = new LabelWidget(compViewFields, SWT.NONE);
      lblDepthLbl.setText("Relation levels:");
      layoutDialog.widgets.spinDepth_lbl = lblDepthLbl;
      let spinDepthWidget = new SpinnerWidget(compViewFields, SWT.BORDER);
      spinDepthWidget.setValues(1, 0, 10, 0, 1, 1);
      spinDepthWidget.setToolTipText("How many steps to follow along relations from the selected elements.\n1 = direct neighbours only. Not used for Layout only.");
      GridDataFactory.swtDefaults().hint(50, SWT.DEFAULT).applyTo(spinDepthWidget);
      layoutDialog.widgets.spinDepth = spinDepthWidget;

      // ── Row 3: Preset bar ─────────────────────────────────────────────────────
      let compPreset = new CompositeWidget(container, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(compPreset);
      GridLayoutFactory.swtDefaults().numColumns(5).margins(2, 2).spacing(6, 0).applyTo(compPreset);

      let lblPreset = new LabelWidget(compPreset, SWT.NONE);
      lblPreset.setText("Preset:");

      let cmbPreset = new ComboWidget(compPreset, SWT.DROP_DOWN | SWT.READ_ONLY);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(cmbPreset);
      layoutDialog.widgets.cmbPreset = cmbPreset;

      function refreshPresetCombo() {
        let prevSel = cmbPreset.getSelectionIndex() >= 0 ? cmbPreset.getItem(cmbPreset.getSelectionIndex()) : null;
        cmbPreset.removeAll();
        getPresetFiles().forEach(function(f) { cmbPreset.add(f); });
        if (prevSel) { let i = cmbPreset.indexOf(prevSel); if (i >= 0) cmbPreset.select(i); }
      }
      refreshPresetCombo();
      layoutDialog._refreshPresetCombo = refreshPresetCombo;

      cmbPreset.addListener(SWT.Selection, function() {
        let idx = cmbPreset.getSelectionIndex();
        if (idx >= 0) {
          let obj = readPresetObj(cmbPreset.getItem(idx));
          cmbPreset.setToolTipText(obj && obj.doc ? obj.doc : "");
        }
      });

      let btnPresetApply = new ButtonWidget(compPreset, SWT.PUSH);
      btnPresetApply.setText("Apply");
      GridDataFactory.fillDefaults().applyTo(btnPresetApply);
      btnPresetApply.setToolTipText("Load the selected preset into the form.");
      btnPresetApply.addListener(SWT.Selection, function() {
        let idx = cmbPreset.getSelectionIndex();
        if (idx >= 0) layoutDialog.updateFromPreset(cmbPreset.getItem(idx));
      });

      let btnPresetSave = new ButtonWidget(compPreset, SWT.PUSH);
      btnPresetSave.setText("Save as…");
      GridDataFactory.fillDefaults().applyTo(btnPresetSave);
      btnPresetSave.setToolTipText("Save the current settings as a new preset.");
      btnPresetSave.addListener(SWT.Selection, function() {
        let fname = window.prompt("Preset name:", "");
        if (fname && fname.trim() !== "") {
          layoutDialog.saveInput();
          let saveObj = JSON.parse(JSON.stringify(layoutDialog.config));
          writePreset(fname.trim(), saveObj);
          refreshPresetCombo();
        }
      });

      let btnPresetManage = new ButtonWidget(compPreset, SWT.PUSH);
      btnPresetManage.setText("Manage…");
      GridDataFactory.fillDefaults().applyTo(btnPresetManage);
      btnPresetManage.setToolTipText("Edit descriptions or delete presets.");
      btnPresetManage.addListener(SWT.Selection, function() {
        layoutDialog.openPresetManager(shell);
        refreshPresetCombo();
      });

      let tabFolder = new TabFolderWidget(container, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(tabFolder);
      layoutDialog.widgets.tabFolder = tabFolder;

      function createRadios(parentGrp, options, colWidth, indent) {
        options.forEach((opt) => {
          let r = new ButtonWidget(parentGrp, SWT.RADIO);
          r.setText(opt.label + "   ");
          r.setData("val", opt.val);
          if (opt.tooltip) r.setToolTipText(opt.tooltip);
          let gd = GridDataFactory.fillDefaults();
          if (colWidth) gd = gd.hint(colWidth, SWT.DEFAULT);
          if (indent)   gd = gd.indent(indent, 0);
          if (colWidth || indent) gd.applyTo(r);
        });
      }

      function shortRelName(type) { return type.replace(/-relationship$/, ""); }

      // Checkbox grid for relation type multi-select (Nesting, Reverse)
      function createRelCheckGrid(name, container, cols, initialSelected) {
        let comp = new CompositeWidget(container, SWT.NONE);
        GridDataFactory.fillDefaults().grab(true, false).span(2, 1).applyTo(comp);
        GridLayoutFactory.swtDefaults().numColumns(cols).margins(0, 2).spacing(6, 2).applyTo(comp);
        let checks = [];
        View.RELATION_NAMES.forEach(function(type) {
          let chk = new ButtonWidget(comp, SWT.CHECK);
          chk.setText(shortRelName(type) + "  ");
          chk.setToolTipText(type);
          chk.setSelection((initialSelected || []).indexOf(type) >= 0);
          checks.push({ type: type, chk: chk });
        });
        layoutDialog.widgets[name + "_checks"] = checks;
      }

      // ── TAB 1: Selection ─────────────────────────────────────────────────────
      let tabGenerate = new TabItemWidget(tabFolder, SWT.NONE);
      tabGenerate.setText("  Selection of elements and relations  ");
      let scrolled1 = new ScrolledCompositeWidget(tabFolder, SWT.H_SCROLL | SWT.V_SCROLL);
      scrolled1.setExpandHorizontal(true);
      scrolled1.setExpandVertical(true);
      let genContainer = new CompositeWidget(scrolled1, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(genContainer);
      tabGenerate.setControl(scrolled1);

      // Group: Element filter
      let grpElemFilter = new GroupWidget(genContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpElemFilter);
      grpElemFilter.setText("Element filter");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpElemFilter);
      let lblElemDesc = new LabelWidget(grpElemFilter, SWT.NONE);
      lblElemDesc.setText("Restrict which element types are included. Leave empty to include all.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblElemDesc);
      layoutDialog.createListBuilder("lstElemTypes", grpElemFilter, null, null,
        View.ELEMENT_NAMES, layoutDialog.config.includeElementType);

      // Group: Relationship filter
      let grpRelFilter = new GroupWidget(genContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpRelFilter);
      grpRelFilter.setText("Relationship filter");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpRelFilter);
      let lblRelDesc = new LabelWidget(grpRelFilter, SWT.NONE);
      lblRelDesc.setText("Restrict which relationship types are followed. Leave empty to follow all.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblRelDesc);
      // Relationship filter: fixed 3-column grid
      // Each row: [checkbox] [short name] [← toggle] [→ toggle]
      // Selecting neither or both toggles = both directions.
      (function() {
        let outerComp = new CompositeWidget(grpRelFilter, SWT.NONE);
        GridDataFactory.fillDefaults().grab(true, false).span(2, 1).applyTo(outerComp);
        GridLayoutFactory.swtDefaults().numColumns(3).margins(0, 2).spacing(16, 2).applyTo(outerComp);

        let rows = [];
        View.RELATION_NAMES.forEach(function(type) {
          let rowComp = new CompositeWidget(outerComp, SWT.NONE);
          GridDataFactory.fillDefaults().grab(true, false).applyTo(rowComp);
          GridLayoutFactory.swtDefaults().numColumns(4).margins(2, 1).spacing(1, 0).applyTo(rowComp);

          let chk = new ButtonWidget(rowComp, SWT.CHECK);
          chk.setToolTipText(type);

          let lbl = new LabelWidget(rowComp, SWT.NONE);
          lbl.setText(" " + shortRelName(type));
          lbl.setToolTipText(type);
          GridDataFactory.fillDefaults().grab(true, false).applyTo(lbl);

          let tglIn  = new ButtonWidget(rowComp, SWT.TOGGLE);
          tglIn.setText("←");
          tglIn.setToolTipText("Incoming only — traversed element is the target.\nSelect neither for both directions.");
          tglIn.setEnabled(false);
          GridDataFactory.swtDefaults().hint(28, 20).applyTo(tglIn);

          let tglOut = new ButtonWidget(rowComp, SWT.TOGGLE);
          tglOut.setText("→");
          tglOut.setToolTipText("Outgoing only — traversed element is the source.\nSelect neither for both directions.");
          tglOut.setEnabled(false);
          GridDataFactory.swtDefaults().hint(28, 20).applyTo(tglOut);

          function updateDirColors() {
            let display = tglIn.getDisplay();
            let white  = display.getSystemColor(SWT.COLOR_WHITE);
            let defBg  = display.getSystemColor(SWT.COLOR_WIDGET_BACKGROUND);
            tglIn.setBackground(tglIn.getSelection()  ? white : defBg);
            tglOut.setBackground(tglOut.getSelection() ? white : defBg);
          }
          tglIn.addListener(SWT.Selection,  function() { updateDirColors(); });
          tglOut.addListener(SWT.Selection, function() { updateDirColors(); });

          chk.addListener(SWT.Selection, function() {
            let on = chk.getSelection();
            tglIn.setEnabled(on); tglOut.setEnabled(on);
            if (!on) { tglIn.setSelection(false); tglOut.setSelection(false); }
            updateDirColors();
          });

          rows.push({ type: type, chk: chk, rdoIn: tglIn, rdoOut: tglOut, updateDirColors: updateDirColors });
        });

        layoutDialog.widgets._relTypeRows = rows;
        layoutDialog.widgets.lstRelTypes  = null;
        layoutDialog._addRelTypeRow       = null;
      })();

      let lblExcludeDesc = new LabelWidget(grpRelFilter, SWT.NONE);
      lblExcludeDesc.setText("To skip specific relations regardless of type, mark them in the Archi model:");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblExcludeDesc);

      layoutDialog.createWidget("chkExcludeFromView", ButtonWidget, grpRelFilter, null,
        "Individual relations can be excluded by setting the property 'excludeFromView = true' on them in the Archi model.\nIn addition to type filtering, this skips specific instances regardless of their type — elements reachable only via those relations will not be included in the view.",
        function (w) {
          w.setText("Skip relations marked as excluded   ");
          GridDataFactory.fillDefaults().span(2, 1).applyTo(w);
        }, SWT.CHECK);

      // Debug checkbox — bottom of Generate tab
      layoutDialog.createWidget("chkDebug", ButtonWidget, genContainer, null,
        "Writes step-by-step processing details to the console. Useful for diagnosing unexpected results.",
        function (w) { w.setText("Write detailed log to console   "); }, SWT.CHECK);

      scrolled1.setContent(genContainer);
      scrolled1.setMinSize(genContainer.computeSize(SWT.DEFAULT, SWT.DEFAULT));
      layoutDialog.widgets._scrolled1     = scrolled1;
      layoutDialog.widgets._genContainer  = genContainer;

      // ── TAB 2: Layout ────────────────────────────────────────────────────────
      let tabLayout = new TabItemWidget(tabFolder, SWT.NONE);
      tabLayout.setText("  Layout and nesting  ");
      let scrolled2 = new ScrolledCompositeWidget(tabFolder, SWT.H_SCROLL | SWT.V_SCROLL);
      scrolled2.setExpandHorizontal(true);
      scrolled2.setExpandVertical(true);
      let layoutContainer = new CompositeWidget(scrolled2, SWT.NONE);
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).applyTo(layoutContainer);
      tabLayout.setControl(scrolled2);

      // Group: Layout style — algorithm list left, description + options right
      let grpELK = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(grpELK);
      grpELK.setText("Layout style");
      GridLayoutFactory.swtDefaults().numColumns(1).margins(10, 10).spacing(4, 4).applyTo(grpELK);

      // Algorithm selection: inline rows — [group label] [radio...] per row
      // grpAlgorithm is the flat composite; setRadio iterates its direct children
      let compAlgo = new CompositeWidget(grpELK, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(compAlgo);
      GridLayoutFactory.swtDefaults().numColumns(4).margins(0, 0).spacing(8, 2).applyTo(compAlgo);
      layoutDialog.widgets.grpAlgorithm = compAlgo;

      let lblHier = new LabelWidget(compAlgo, SWT.NONE);
      lblHier.setText("Hierarchical:");
      lblHier.setToolTipText("Arrange elements in ranked layers following relation direction.\nBest for diagrams with a clear hierarchy or flow.");
      GridDataFactory.fillDefaults().hint(115, SWT.DEFAULT).applyTo(lblHier);
      createRadios(compAlgo, [
        { label: "Layered", val: "layered", tooltip: "Arranges elements in ranked layers following the direction of relations. The most thorough and configurable style — handles complex structures, cross-hierarchy connections, and fine-grained control. Best choice for most ArchiMate views." },
        { label: "Dagre",   val: "dagre",   tooltip: "Alternative hierarchical layout using a different ranking method. Faster on larger diagrams. Try this when Layered produces unsatisfactory results. Supports layer ranking." },
        { label: "Tree",    val: "mrtree",  tooltip: "Ideal for pure tree structures and organisation charts." },
      ]);

      let lblOrg = new LabelWidget(compAlgo, SWT.NONE);
      lblOrg.setText("Organic:");
      lblOrg.setToolTipText("Position elements based on relation weights, without a fixed direction.\nBest for exploratory or undirected diagrams.");
      GridDataFactory.fillDefaults().hint(115, SWT.DEFAULT).applyTo(lblOrg);
      createRadios(compAlgo, [
        { label: "Force",   val: "force",  tooltip: "Free-form layout driven by relation weights. Good for exploratory overviews." },
        { label: "Stress",  val: "stress", tooltip: "Similar to Force but aims for more even spacing between elements." },
        { label: "Radial",  val: "radial", tooltip: "Elements radiate outward in rings from the starting element. Ring spacing is set by level spacing." },
      ]);

      let lblPack = new LabelWidget(compAlgo, SWT.NONE);
      lblPack.setText("Packing:");
      lblPack.setToolTipText("Arrange elements compactly without following relation direction.\nBest for diagrams with disconnected or loosely related elements.");
      GridDataFactory.fillDefaults().hint(115, SWT.DEFAULT).applyTo(lblPack);
      createRadios(compAlgo, [
        { label: "Grid", val: "box",         tooltip: "Arranges elements with few or no connections in a compact grid." },
        { label: "Pack", val: "rectpacking", tooltip: "Packs elements into the smallest rectangle with no gaps. Best for nesting views where all relations render as containers — no visible connections." },
      ]);
      new LabelWidget(compAlgo, SWT.NONE); // filler to complete the row

      let algoChildren = compAlgo.getChildren();
      for (let i = 0; i < algoChildren.length; i++) {
        if (algoChildren[i].getData("val") !== null && algoChildren[i].getData("val") !== undefined) {
          algoChildren[i].addListener(SWT.Selection, function (e) {
            if (e.widget.getSelection()) layoutDialog.updateAlgoControls(e.widget.getData('val'));
          });
        }
      }

      // Spacer between algo selection and parameters
      new LabelWidget(grpELK, SWT.NONE);

      // Parameters: flat rows below algo selection — no box, just whitespace above
      let cDir = new CompositeWidget(grpELK, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(cDir);
      GridLayoutFactory.swtDefaults().numColumns(5).margins(0, 0).spacing(8, 0).applyTo(cDir);
      let lblDir = new LabelWidget(cDir, SWT.NONE);
      lblDir.setText("Flow direction:");
      GridDataFactory.fillDefaults().hint(115, SWT.DEFAULT).applyTo(lblDir);
      layoutDialog.widgets.grpDir = cDir;
      createRadios(cDir, [
        { label: "Right", val: "RIGHT", tooltip: "Relations flow from left to right. With nested containers, elements outside a container appear to the left or right of it." },
        { label: "Down",  val: "DOWN",  tooltip: "Relations flow downward. Recommended when using nested containers." },
        { label: "Up",    val: "UP",    tooltip: "Relations flow upward." },
        { label: "Left",  val: "LEFT",  tooltip: "Relations flow from right to left." },
      ]);

      let cRouting = new CompositeWidget(grpELK, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(cRouting);
      GridLayoutFactory.swtDefaults().numColumns(5).margins(0, 0).spacing(8, 0).applyTo(cRouting);
      let lblRouting = new LabelWidget(cRouting, SWT.NONE);
      lblRouting.setText("Relation style:");
      GridDataFactory.fillDefaults().hint(115, SWT.DEFAULT).applyTo(lblRouting);
      layoutDialog.widgets.grpEdgeRouting = cRouting;
      createRadios(cRouting, [
        { label: "Orthogonal", val: "ORTHOGONAL", tooltip: "Relations are drawn with right-angle bends. Works best with Layered layout." },
        { label: "Polyline",   val: "POLYLINE",   tooltip: "Relations follow a path with diagonal bends. Works with all layout styles." },
        { label: "Straight",   val: "STRAIGHT",   tooltip: "Relations are drawn as straight lines between elements." },
      ]);
      new LabelWidget(cRouting, SWT.NONE); // filler

      let cRanker = new CompositeWidget(grpELK, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(cRanker);
      GridLayoutFactory.swtDefaults().numColumns(5).margins(0, 0).spacing(8, 0).applyTo(cRanker);
      let lblRanker = new LabelWidget(cRanker, SWT.NONE);
      lblRanker.setText("Layer ranking:");
      GridDataFactory.fillDefaults().hint(115, SWT.DEFAULT).applyTo(lblRanker);
      layoutDialog.widgets.grpRanker = cRanker;
      createRadios(cRanker, [
        { label: "Balanced",    val: "network-simplex", tooltip: "Minimises relation lengths and crossings. Produces the most polished result. Best for most diagrams. This is the default." },
        { label: "Uniform",     val: "tight-tree",      tooltip: "Nearly the same quality as Balanced but significantly faster. Good choice for large diagrams with many elements." },
        { label: "Top-aligned", val: "longest-path",    tooltip: "Fastest option. Places elements as high as possible — leaf elements appear at the bottom. May produce longer relation lines." },
      ]);
      new LabelWidget(cRanker, SWT.NONE); // filler

      layoutDialog.createWidget("chkUseWeights", ButtonWidget, grpELK, null,
        "Assigns a weight to each relation type that controls how strongly connected elements attract each other.\nHighest: Composition, Aggregation. Lowest: Influence.",
        function (w) {
          w.setText("Use relation weights — attract elements by relation type   ");
        }, SWT.CHECK);

      // Group: Spacing & size [E]
      let grpSpacing = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, false).applyTo(grpSpacing);
      grpSpacing.setText("Spacing & size");
      GridLayoutFactory.swtDefaults().numColumns(4).margins(10, 10).spacing(6, 4).applyTo(grpSpacing);

      layoutDialog.createWidget("spinWidth",    SpinnerWidget, grpSpacing, "Element width:",    null,                                             function (w) { w.setValues(200, 10, 600, 0, 10, 50); GridDataFactory.swtDefaults().hint(50, SWT.DEFAULT).applyTo(w); });
      layoutDialog.createWidget("spinHeight",   SpinnerWidget, grpSpacing, "Element height:",   null,                                             function (w) { w.setValues(60,  10, 400, 0, 10, 20); GridDataFactory.swtDefaults().hint(50, SWT.DEFAULT).applyTo(w); });
      layoutDialog.createWidget("spinNodeSep",  SpinnerWidget, grpSpacing, "Element spacing:",  "Space between elements on the same level.",      function (w) { w.setValues(40,  0, 600, 0, 10, 50); GridDataFactory.swtDefaults().hint(50, SWT.DEFAULT).applyTo(w); });
      layoutDialog.createWidget("spinLayerSep", SpinnerWidget, grpSpacing, "Level spacing:",    "Space between levels or layers in the diagram.", function (w) { w.setValues(180, 0, 600, 0, 10, 50); GridDataFactory.swtDefaults().hint(50, SWT.DEFAULT).applyTo(w); });

      // Group: Reverse [C — before Nesting; affects direction of hierarchical algorithms]
      let grpReverse = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpReverse);
      grpReverse.setText("Reverse");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpReverse);
      let lblRevDesc = new LabelWidget(grpReverse, SWT.NONE);
      lblRevDesc.setText("Select which relationship types should be drawn in the opposite direction in the layout.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblRevDesc);
      createRelCheckGrid("lstReversed", grpReverse, 4, layoutDialog.config.layoutReversed);

      // Group: Nesting [A — relation list + occurrence options only]
      let grpNested = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpNested);
      grpNested.setText("Nesting");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpNested);

      let lblNestDesc = new LabelWidget(grpNested, SWT.NONE);
      lblNestDesc.setText("Select which relationship types render the related element inside a container.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(lblNestDesc);

      createRelCheckGrid("lstNested", grpNested, 4, layoutDialog.config.layoutNested);

      let sepNestOpts = new LabelWidget(grpNested, SWT.SEPARATOR | SWT.HORIZONTAL);
      GridDataFactory.fillDefaults().grab(true, false).span(2, 1).applyTo(sepNestOpts);

      layoutDialog.createWidget("chkMultiOcc", ButtonWidget, grpNested, null,
        "When enabled, an element that belongs to multiple containers is shown inside each of them.\nWhen disabled (default), it appears only in the first matching container.",
        function (w) {
          w.setText("Show element in every container   ");
          GridDataFactory.fillDefaults().span(2, 1).applyTo(w);
        }, SWT.CHECK);

      layoutDialog.createWidget("spinPadding", SpinnerWidget, grpNested,
        "Container padding:", "Space between the edge of a container and its child elements.",
        function (w) {
          w.setValues(20, 0, 100, 0, 5, 10);
          GridDataFactory.swtDefaults().hint(50, SWT.DEFAULT).applyTo(w);
        });

      let chkSortLeavesOnly = new ButtonWidget(grpNested, SWT.CHECK);
      chkSortLeavesOnly.setText("Sort elements only — keep containers in model order   ");
      chkSortLeavesOnly.setToolTipText("When checked, only leaf elements are sorted alphabetically.\nContainers stay in the order they appear in the model.\nWhen unchecked (default), containers are placed first and also sorted.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(chkSortLeavesOnly);
      layoutDialog.widgets.chkSortLeavesOnly = chkSortLeavesOnly;

      // Group: Packed layout [A — pack options split out; D — lstExpandExclude greyed when expand is off]
      let grpPacked = new GroupWidget(layoutContainer, SWT.NONE);
      GridDataFactory.fillDefaults().grab(true, true).applyTo(grpPacked);
      grpPacked.setText("Packed layout");
      GridLayoutFactory.swtDefaults().numColumns(2).margins(10, 10).applyTo(grpPacked);

      let chkNestedPack = new ButtonWidget(grpPacked, SWT.CHECK);
      chkNestedPack.setText("Pack container children tightly (rectpacking)   ");
      chkNestedPack.setToolTipText("Uses rectangle packing inside each container instead of the root layout algorithm.\nEliminates empty space in containers. Best when all relations are nesting — no visible connections.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(chkNestedPack);
      layoutDialog.widgets.chkNestedPack = chkNestedPack;

      let lblNestedSpacing = new LabelWidget(grpPacked, SWT.NONE);
      lblNestedSpacing.setText("Child spacing:");
      lblNestedSpacing.setToolTipText("Space between child elements inside a packed container.");
      layoutDialog.widgets._lblNestedSpacing = lblNestedSpacing;
      let spinNestedSpacing = new SpinnerWidget(grpPacked, SWT.BORDER);
      spinNestedSpacing.setValues(10, 0, 100, 0, 2, 10);
      spinNestedSpacing.setToolTipText("Space between child elements inside a packed container.");
      GridDataFactory.swtDefaults().hint(50, SWT.DEFAULT).applyTo(spinNestedSpacing);
      layoutDialog.widgets.spinNestedSpacing = spinNestedSpacing;

      let chkExpandToFill = new ButtonWidget(grpPacked, SWT.CHECK);
      chkExpandToFill.setText("Equal row height — expand elements to match containers   ");
      chkExpandToFill.setToolTipText("When a row contains both sub-containers (tall) and leaf elements (short), expands all items in the row to the same height.\nUse this when containers and plain elements appear side by side and you want them visually equal.");
      GridDataFactory.fillDefaults().span(2, 1).applyTo(chkExpandToFill);
      layoutDialog.widgets.chkExpandToFill = chkExpandToFill;

      layoutDialog.createListBuilder("lstExpandExclude", grpPacked,
        "Keep original size for (not expanded):", "Element types that are never resized to match containers — they keep their natural nodeWidth × nodeHeight.",
        View.ELEMENT_NAMES, layoutDialog.config.elkExpandExcludeTypes || []);

      // Recursive enable/disable for composite widget trees [D]
      function setTreeEnabled(comp, enabled) {
        comp.setEnabled(enabled);
        var ch = comp.getChildren();
        for (var i = 0; i < ch.length; i++) {
          if (typeof ch[i].getChildren === 'function') setTreeEnabled(ch[i], enabled);
          else ch[i].setEnabled(enabled);
        }
      }
      function updatePackControls() {
        let packOn   = chkNestedPack.getSelection();
        let expandOn = packOn && chkExpandToFill.getSelection();
        lblNestedSpacing.setEnabled(packOn);
        spinNestedSpacing.setEnabled(packOn);
        chkExpandToFill.setEnabled(packOn);
        if (layoutDialog.widgets.lstExpandExclude_comp)
          setTreeEnabled(layoutDialog.widgets.lstExpandExclude_comp, expandOn);
      }
      layoutDialog._updatePackControls = updatePackControls;
      updatePackControls();
      chkNestedPack.addListener(SWT.Selection,   function() { updatePackControls(); });
      chkExpandToFill.addListener(SWT.Selection, function() { updatePackControls(); });

      scrolled2.setContent(layoutContainer);
      scrolled2.setMinSize(layoutContainer.computeSize(SWT.DEFAULT, SWT.DEFAULT));
      layoutDialog.widgets._scrolled2       = scrolled2;
      layoutDialog.widgets._layoutContainer = layoutContainer;


      layoutDialog.syncConfigToUI();
      return area;
    },

    isHelpAvailable: function () {
      return false;
    },

    createButtonsForButtonBar: function (parent) {
      let IDialogConstants = Java.type("org.eclipse.jface.dialogs.IDialogConstants");
      Java.super(layoutDialog.dialog).createButton(parent, IDialogConstants.CANCEL_ID, IDialogConstants.CANCEL_LABEL, false);
      Java.super(layoutDialog.dialog).createButton(parent, IDialogConstants.OK_ID, "Generate", true);
    },

    okPressed: function () {
      layoutDialog.saveInput();
      Java.super(layoutDialog.dialog).okPressed();
    },
  }),
};

const OK = layoutDialog.open();

if (!OK) {
  console.log("Operation cancelled.");
  exit();
}

writeJSON(LAST_RUN_FILE, layoutDialog.config);

View.generate_view(layoutDialog.config, initialSelection);
Common.finishConsoleLog();
