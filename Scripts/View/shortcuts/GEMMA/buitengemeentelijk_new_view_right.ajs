/**
 * Shortcut: run a preset on the selection. The filename names the preset, action and direction:
 *   <preset>_<new_view|one_view_each|expand_view|layout>_<right|left|down|up>.ajs
 * Preset: Scripts/View/presets/GEMMA/<preset>.json
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common    = require(REPO_ROOT + "_lib/Common");
const RunPreset = require(REPO_ROOT + "View/lib/run_preset");

Common.initConsoleLog(__FILE__, true);
RunPreset.fromFilename(__FILE__, $(selection), { folder: "GEMMA" });
Common.finishConsoleLog();
