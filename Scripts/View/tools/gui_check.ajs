/**
 * Drive the View dialog with real OS input and screenshot the screen after each action: a dialog check
 * the agent runs itself, judged on the screenshots and the console. Opens the dialog as _gui.ajs does,
 * runs one suite of steps once it is shown, then closes it as its close button does (Cancel, no run);
 * the session is not saved. Method and judging: skill view-testing, § Dialog check.
 *
 * Environment:
 *   SELECT_ID  the object to select, by id (the command line has no selection)
 *   PRESET     the dialog opens on this preset instead of the session
 *   SHOTS      folder for the screenshots (NN_<name>.png), must exist
 *   SUITE      the steps to run: "tables" (default, the condition-table checklist), "open" (the dialog as it opens)
 *              or "nestingStyle" (the nesting style table on the Appearance tab, the View template row on the Layout tab)
 * Each key logs the control that has the focus ("key … → focus List"), so a key that went elsewhere shows.
 *
 * Do not touch mouse or keyboard while it runs: the input is posted to the desktop (Display.post).
 * Windows (Git Bash), on a copy of the model:
 *   SELECT_ID=… PRESET="Bestuurscontext/Capability" SHOTS=<dir> ~/scoop/apps/archi/current/Archi.exe \
 *     -application com.archimatetool.commandline.app -consoleLog -nosplash --loadModel <copy> \
 *     --script.runScript "$(pwd -W)/Scripts/View/tools/gui_check.ajs" > gui_check.txt 2>&1
 * Linux, in an X server of its own (Wayland: the desktop's XWayland reads its screen as black):
 *   Xvfb :97 -screen 0 2000x1900x24 &
 *   env -u WAYLAND_DISPLAY DISPLAY=:97 SELECT_ID=… PRESET=… SHOTS=<dir> Scripts/View/tools/archi_cli.sh Scripts/View/tools/gui_check.ajs <model>
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const System = Java.type("java.lang.System");
const SWT = Java.type("org.eclipse.swt.SWT");
const Display = Java.type("org.eclipse.swt.widgets.Display");
const SWTEvent = Java.type("org.eclipse.swt.widgets.Event");
const Composite = Java.type("org.eclipse.swt.widgets.Composite");
const TabFolder = Java.type("org.eclipse.swt.widgets.TabFolder");
const Table = Java.type("org.eclipse.swt.widgets.Table");
const Button = Java.type("org.eclipse.swt.widgets.Button");
const Label = Java.type("org.eclipse.swt.widgets.Label");
const Group = Java.type("org.eclipse.swt.widgets.Group");
const Text = Java.type("org.eclipse.swt.widgets.Text");
const ScrolledComposite = Java.type("org.eclipse.swt.custom.ScrolledComposite");
const ListClass = Java.type("org.eclipse.swt.widgets.List");
const ComboClass = Java.type("org.eclipse.swt.widgets.Combo");
const Image = Java.type("org.eclipse.swt.graphics.Image");
const GC = Java.type("org.eclipse.swt.graphics.GC");
const ImageLoader = Java.type("org.eclipse.swt.graphics.ImageLoader");
const Rectangle = Java.type("org.eclipse.swt.graphics.Rectangle");

if (typeof require !== "function") { const m = "This script needs jArchi 1.11 or later, with CommonJS on: in Archi, open Preferences > Scripting and tick \"Enable CommonJS Support\" (no such option: update jArchi first). Then run the script again."; try { window.alert(m); } catch (e) { console.error(m); } exit(); }
const PresetIO = require(REPO_ROOT + "View/lib/preset_io.js");
const TabProperties = require(REPO_ROOT + "View/lib/gui/tab_properties.js");
const DialogMain = require(REPO_ROOT + "View/lib/gui/dialog_main.js");

const SHOTS = String(System.getenv("SHOTS"));
const SUITE = String(System.getenv("SUITE") || "tables");
const presetName = System.getenv("PRESET");
if (presetName) PresetIO.readSession = () => Object.assign(PresetIO.readPreset(String(presetName)), { name: String(presetName) });
PresetIO.writeSession = () => {};   // the check leaves the session as it was

const display = Display.getDefault();
/** @type {any} */ let shell = null;
/** @type {any} */ let tabFolder = null;
let nShot = 0;

/** @param {string} s */
function log(s) { console.log("[check] " + s); }

// ── Screenshots ──────────────────────────────────────────────────────────────

/** The screen inside a display rectangle (clipped to the monitor) as SHOTS/NN_<name>.png. @param {string} name @param {any} r */
function shot(name, r) {
  const m = shell.getMonitor().getBounds();
  const x = Math.max(m.x, r.x), y = Math.max(m.y, r.y);
  const w = Math.min(m.x + m.width, r.x + r.width) - x, h = Math.min(m.y + m.height, r.y + r.height) - y;
  const img = new Image(display, w, h);
  const gc = new GC(display);
  gc.copyArea(img, x, y);
  gc.dispose();
  const loader = new ImageLoader();
  loader.data = Java.to([img.getImageData()], "org.eclipse.swt.graphics.ImageData[]");
  const file = `${SHOTS}/${String(++nShot).padStart(2, "0")}_${name}.png`;
  loader.save(file, SWT.IMAGE_PNG);
  img.dispose();
  log(`shot ${file}`);
}
/** @param {string} name */
const shotShell = name => shot(name, shell.getBounds());
/**
 * Press a button that opens a pop-up or a modal dialog, shoot the monitor, close what opened. A modal
 * dialog blocks this step until it closes, so the shot and the close are timed before the press.
 * @param {string} name
 * @param {any} btn
 * @param {(opened: any) => void} [inside]  runs on the shot's timer, before the shot: types into the dialog
 */
function pressAndShoot(name, btn, inside) {
  display.timerExec(1200, () => {
    const opened = display.getActiveShell();
    if (inside) inside(opened);
    display.timerExec(500, () => {
      shot(name, shell.getMonitor().getBounds());
      const now = display.getActiveShell();
      if (now && now !== shell) now.dispose();
      for (const s of display.getShells()) if (s !== shell && !s.isDisposed() && s.getParent() === shell) s.dispose();
    });
  });
  btn.notifyListeners(SWT.Selection, new SWTEvent());
}
/** Every button with this text, in tree order. @param {string} text */
function buttonsNamed(text) {
  /** @type {any[]} */ const found = [];
  /** @param {any} c */
  const walk = c => {
    if (c instanceof Button && String(c.getText()) === text) found.push(c);
    if (c instanceof Composite) for (const ch of c.getChildren()) walk(ch);
  };
  walk(shell);
  return found;
}
/**
 * The action area as text, cheaper and more exact than a screenshot for text, grey and bold: per group
 * every visible label, button and text field ("[…]"), "(grey)" when disabled, "*…*" when bold, "(x)" a chosen radio.
 * The run buttons follow the groups.
 * @param {string} name
 */
function logActionArea(name) {
  const lines = [];
  /** @param {any} c @param {string} indent */
  const walk = (c, indent) => {
    if (!c.isVisible()) return;
    if (c instanceof Text) { const bold = (c.getFont().getFontData()[0].getStyle() & SWT.BOLD) !== 0; lines.push(`${indent}[${bold ? `*${c.getText()}*` : c.getText()}]${c.isEnabled() ? "" : " (grey)"}`); return; }
    if (c instanceof Label || c instanceof Button) {
      const text = String(c.getText()).replace(/\n/g, " ");
      if (!text) return;
      const bold = (c.getFont().getFontData()[0].getStyle() & SWT.BOLD) !== 0;
      const radio = (c.getStyle() & SWT.RADIO) !== 0 ? (c.getSelection() ? "(x) " : "( ) ") : "";
      lines.push(`${indent}${radio}${bold ? `*${text}*` : text}${c.isEnabled() ? "" : " (grey)"}`);
      return;
    }
    if (c instanceof Composite) for (const ch of c.getChildren()) walk(ch, c instanceof Group ? indent + "  " : indent);
  };
  /** The row of the two groups. @param {any} c @returns {any} */
  const groupRow = c => {
    if (c instanceof Group && String(c.getText()) === "Create new view") return c.getParent();
    if (!(c instanceof Composite)) return null;
    for (const ch of c.getChildren()) { const f = groupRow(ch); if (f) return f; }
    return null;
  };
  const row = groupRow(shell);
  for (const g of row.getChildren()) { lines.push(String(g.getText())); walk(g, "  "); }
  const siblings = [...row.getParent().getChildren()];
  walk(siblings[siblings.indexOf(row) + 1], "");   // Run and Cancel
  log(`action area ${name}:\n  ${lines.join("\n  ")}`);
}
/** A table with its footer and room for tooltips, lists and menus. @param {string} name @param {any} t */
const shotTable = (name, t) => {
  const b = t.getParent().getBounds();
  const at = t.getParent().getParent().toDisplay(b.x, b.y);
  shot(name, new Rectangle(at.x - 20, at.y - 40, b.width + 320, b.height + 380));
};

// ── OS input ─────────────────────────────────────────────────────────────────

/** @param {number} type @param {Record<string, any>} props */
function post(type, props) { const e = new SWTEvent(); e.type = type; Object.assign(e, props); display.post(e); }
/**
 * On GTK, Display.post builds a button event without its position (x, y arrive as the control's
 * negative origin), so a control that reads the position (a table cell) gets no hit: give each button
 * event the pointer's position, which the posted motion did set.
 */
function fixButtonPositionGTK() {
  if (String(SWT.getPlatform()) !== "gtk") return;
  for (const type of [SWT.MouseDown, SWT.MouseUp]) {
    display.addFilter(type, (/** @type {any} */ e) => {
      const p = e.widget.toControl(display.getCursorLocation());
      e.x = p.x; e.y = p.y;
    });
  }
}
/** @param {number} x @param {number} y */
function moveTo(x, y) { post(SWT.MouseMove, { x, y }); }
/** @param {number} x @param {number} y */
function clickAt(x, y) { moveTo(x, y); post(SWT.MouseDown, { button: 1 }); post(SWT.MouseUp, { button: 1 }); }
/**
 * A key: an SWT key code (arrows, Home) or a character (Enter, Esc, Space, Tab). Win32 maps a character,
 * not a key code like 13, to its key.
 * @param {number | string} k
 */
function key(k) {
  const f = display.getFocusControl();
  log(`key ${JSON.stringify(k)} → focus ${f ? f.getClass().getSimpleName() : "none"}`);
  const props = typeof k === "string" ? { character: k } : { keyCode: k };
  post(SWT.KeyDown, props); post(SWT.KeyUp, props);
}
const K = { UP: SWT.ARROW_UP, DOWN: SWT.ARROW_DOWN, LEFT: SWT.ARROW_LEFT, RIGHT: SWT.ARROW_RIGHT, HOME: SWT.HOME,
            ENTER: "\r", ESC: "\u001b", SPACE: " ", TAB: "\t" };
function shiftTab() { post(SWT.KeyDown, { keyCode: SWT.SHIFT }); key(K.TAB); post(SWT.KeyUp, { keyCode: SWT.SHIFT }); }
/** The mouse on the dialog's title area: outside every table, so a tooltip starts afresh. */
const away = () => moveTo(shell.getBounds().x + 5, shell.getBounds().y + 100);

// ── Finding controls ─────────────────────────────────────────────────────────

/** Every Table of the dialog with its tab and column headers. @returns {{ tab: string, t: any, headers: string[] }[]} */
function tables() {
  /** @type {{ tab: string, t: any, headers: string[] }[]} */
  const out = [];
  /** @param {any} c @param {string} tab */
  const walk = (c, tab) => {
    if (c instanceof Table) out.push({ tab, t: c, headers: c.getColumns().map((/** @type {any} */ col) => String(col.getText())) });
    if (!(c instanceof Composite)) return;
    const items = c instanceof TabFolder ? c.getItems() : [];
    for (const ch of c.getChildren()) {
      const it = items.find((/** @type {any} */ i) => i.getControl() === ch);
      walk(ch, it ? String(it.getText()) : tab);
    }
  };
  walk(shell, "other");
  return out;
}
/** The nth table on a tab with a column of this header. @param {string} tab @param {string} header @param {number} [nth] */
function table(tab, header, nth) {
  const f = tables().filter(x => x.tab === tab && x.headers.includes(header))[nth || 0];
  if (!f) throw new Error(`no table on ${tab} with column ${header}`);
  return f.t;
}
/** @param {any} t @param {string | number} col  header or index */
const colIdx = (t, col) => typeof col === "number" ? col : t.getColumns().map((/** @type {any} */ c) => String(c.getText())).indexOf(col);
/** Scroll the tab so the table shows. @param {any} t */
function reveal(t) {
  for (let p = t.getParent(); p; p = p.getParent()) if (p instanceof ScrolledComposite) { p.showControl(t.getParent()); break; }
}
/** @param {any} ctrl @param {any} r */
const centerOf = (ctrl, r) => ctrl.toDisplay(r.x + Math.floor(r.width / 2), r.y + Math.floor(r.height / 2));
/** @param {any} t @param {number} row @param {string | number} col */
const cellCenter = (t, row, col) => { reveal(t); return centerOf(t, t.getItem(row).getBounds(colIdx(t, col))); };
/** @param {any} t @param {number} row @param {string | number} col */
function clickCell(t, row, col) { const p = cellCenter(t, row, col); clickAt(p.x, p.y); }
/** @param {any} t @param {number} row @param {string | number} col */
function hoverCell(t, row, col) { const p = cellCenter(t, row, col); moveTo(p.x - 1, p.y); moveTo(p.x, p.y); }
/** @param {any} t @param {string} header */
function hoverHeader(t, header) {
  reveal(t);
  const cols = t.getColumns(), ci = colIdx(t, header);
  let x = 0;
  for (let i = 0; i < ci; i++) x += cols[i].getWidth();
  const p = t.toDisplay(x + Math.floor(cols[ci].getWidth() / 2), Math.floor(t.getHeaderHeight() / 2));
  moveTo(p.x - 1, p.y); moveTo(p.x, p.y);
}
/** A condition table's footer control: 0 = + Add condition, 1 = Match property. @param {any} t @param {number} i */
const footerChild = (t, i) => t.getParent().getChildren()[2].getChildren()[i];
/** @param {any} c */
function moveToControl(c) { const p = centerOf(c.getParent(), c.getBounds()); moveTo(p.x, p.y); }
/** @param {any} c */
function clickControl(c) { const p = centerOf(c.getParent(), c.getBounds()); clickAt(p.x, p.y); }
/** The dialog's button with this text (a radio, a push button, a checkbox label). @param {string} text */
function button(text) {
  /** @param {any} c @returns {any} */
  const find = c => {
    if ((c instanceof Button || c instanceof Label) && String(c.getText()) === text) return c;
    if (!(c instanceof Composite)) return null;
    for (const ch of c.getChildren()) { const f = find(ch); if (f) return f; }
    return null;
  };
  const b = find(shell);
  if (!b) throw new Error(`no button ${text}`);
  return b;
}
/** Scroll the tab so the control shows. @param {any} c */
function showInScroll(c) {
  for (let p = c.getParent(); p; p = p.getParent()) if (p instanceof ScrolledComposite) { p.showControl(c); break; }
}
/** The texts of the visible note labels on every tab. @returns {string[]} */
function notes() {
  /** @type {string[]} */
  const out = [];
  /** @param {any} c */
  const walk = c => {
    if (c instanceof Label && c.getData("note") && c.getVisible() && String(c.getText())) out.push(String(c.getText()).slice(0, 70));
    if (c instanceof Composite) for (const ch of c.getChildren()) walk(ch);
  };
  walk(shell);
  return out;
}
/** @param {string} name */
function clickTab(name) {
  const it = tabFolder.getItems().find((/** @type {any} */ i) => String(i.getText()) === name);
  const p = centerOf(tabFolder, it.getBounds());
  clickAt(p.x, p.y);
}

// ── Suites: [ms to wait before the step, step] ───────────────────────────────
// A native tooltip lies over the controls below it and takes a click: move away before clicking there.

const ELEMENT = () => table("Selection", "Element / source type");
const STEP    = () => table("Selection", "Previous step elements");
const NESTING = () => table("Layout", "Nested");
const STYLE   = () => table("Appearance", "Apply to");
const NSTYLE  = () => table("Appearance", "Parent type");

/** The open pop-up of a compound cell: a shell on the dialog's shell. */
const popup = () => [...display.getShells()].find((/** @type {any} */ s) => s !== shell && !s.isDisposed() && s.isVisible() && s.getParent() === shell);
/** The lists in the open pop-up, in field order. */
const popupLists = () => { const out = []; const walk = (/** @type {any} */ c) => { for (const k of c.getChildren()) { if (k instanceof ListClass) out.push(k); else if (k.getChildren) walk(k); } }; const p = popup(); if (p) walk(p); return out; };
/** Click item i of a list in the pop-up. @param {any} list @param {number} i */
function clickListItem(list, i) { const h = list.getItemHeight(); const p = list.toDisplay(10, i * h + Math.floor(h / 2)); clickAt(p.x, p.y); }
/** Open a cell as a click does, without a posted click (on GTK the pointer is not always where a posted move put it): the table's MouseUp at the cell. @param {any} t @param {number} row @param {string} col */
function openCell(t, row, col) {
  reveal(t);
  const r = t.getItem(row).getBounds(colIdx(t, col));
  const e = new SWTEvent(); e.button = 1; e.x = r.x + 5; e.y = r.y + Math.floor(r.height / 2);
  display.setCursorLocation(t.toDisplay(e.x, e.y));   // fixButtonPositionGTK takes the position from the pointer
  t.notifyListeners(SWT.MouseUp, e);
}
/** Press a button of the open pop-up window. @param {string} text */
function pressInPopup(text) {
  const p = popup(); if (!p) return;
  /** @type {any} */ let found = null;
  const walk = (/** @type {any} */ c) => { for (const k of c.getChildren()) { if (k instanceof Button && String(k.getText()) === text) found = k; else if (k instanceof Composite) walk(k); } };
  walk(p);
  if (found) found.notifyListeners(SWT.Selection, new SWTEvent());
}
/** Choose item i of the combo in the open pop-up window. @param {number} i */
function chooseInPopupCombo(i) {
  const p = popup(); if (!p) return;
  /** @type {any} */ let found = null;
  const walk = (/** @type {any} */ c) => { for (const k of c.getChildren()) { if (k instanceof ComboClass) found = k; else if (k instanceof Composite) walk(k); } };
  walk(p);
  if (found) { found.select(i); found.notifyListeners(SWT.Selection, new SWTEvent()); }
}
/** The text of a table cell as the table draws it is not readable; the condition's summary is logged instead. @param {any} t @param {number} row @param {string} col */
function cellText(t, row, col) { return `${t.getItem(row).getBounds(colIdx(t, col))}`; }
/** Log what the pop-up shows, as text. @param {string} name */
function logPopup(name) {
  const p = popup();
  if (!p) { log(`${name}: no pop-up; shells: ${[...display.getShells()].map((/** @type {any} */ s) => `"${s.getText()}" visible=${s.isVisible()} onDialog=${s.getParent() === shell} dialog=${s === shell}`).join(" | ")}`); return; }
  /** @type {string[]} */
  const lines = [];
  const walk = (/** @type {any} */ c) => { for (const k of c.getChildren()) {
    const cls = k instanceof Label ? "Label" : k instanceof ComboClass ? "Combo" : k instanceof ListClass ? "List" : k instanceof Text ? "Text" : "";
    if (cls === "Label") lines.push(`Label "${k.getText()}" ${k.getEnabled() ? "" : "(grey)"}`);
    else if (cls === "Combo") lines.push(`Combo "${k.getText()}" ${k.getEnabled() ? "" : "(grey)"}`);
    else if (cls === "List") lines.push(`List [${[...k.getItems()].slice(0, 6).join(", ")}${k.getItemCount() > 6 ? ", …" : ""}] selected ${k.getSelectionIndex()} ${k.getEnabled() ? "" : "(grey)"}`);
    else if (cls === "Text") lines.push(`Text "${k.getText()}" ${k.getEnabled() ? "" : "(grey)"}`);
    if (k.getChildren) walk(k);
  } };
  walk(p);
  log(`${name}: window "${p.getText()}" ${p.getBounds()}\n  ${lines.join("\n  ")}`);
}

/** @type {Record<string, [number, () => void][]>} */
const SUITES = {
  // The folder and view template pickers: their buttons next to the fields.
  pickers: [
    [2500, () => pressAndShoot("edit_description", buttonsNamed("Edit…")[0])],
    [2500, () => clickTab("Layout")],
    [1500, () => shotShell("layout")],
    [100,  () => clickTab("Selection")],
    [1500, () => { logActionArea("create"); shotShell("create"); }],
    [300,  () => { log("… buttons: " + buttonsNamed("…").length); pressAndShoot("folder_dialog", buttonsNamed("…")[1]); }],
    [2500, () => clickTab("Layout")],
    [1000, () => pressAndShoot("template_dialog", buttonsNamed("…")[0])],
    [2500, () => log("pop-up shot taken")],
  ],
  // The dialog as it opens: the Selection tab and the action area.
  open: [
    // Each table as high as its header and rows: a shortfall cuts off the last row.
    [2500, () => { log("table sizes:\n  " + tables().map(x => { const t = x.t, n = t.getItemCount();
      return `${x.tab} ${x.headers[x.headers.length - 1]}: ${n} rows, item ${t.getItemHeight()} px, header ${t.getHeaderHeight()} px, ` +
             `client ${t.getClientArea().height} px, needed ${t.getHeaderHeight() + n * t.getItemHeight()} px`; }).join("\n  ")); }],
    [100,  () => clickTab("Selection")],
    [1500, () => { logActionArea("open"); shotShell("open"); }],
    [1000, () => moveToControl(button("One view each"))],
    [300,  () => clickControl(button("One view each"))],
    [1500, () => { logActionArea("one_view_each"); shotShell("one_view_each"); }],
    [1000, () => moveToControl(button("Mirrored"))],
    [300,  () => clickControl(button("Mirrored"))],
    [1500, () => { logActionArea("mirrored"); shotShell("mirrored"); }],
    [1000, () => moveToControl(button("In the folder"))],
    [300,  () => clickControl(button("In the folder"))],
    [1000, () => moveToControl(button("New view"))],
    [300,  () => clickControl(button("New view"))],
    [1500, () => { logActionArea("new_view"); shotShell("new_view"); }],
    [1000, () => { if (button("Layout only").getEnabled()) clickControl(button("Layout only")); }],
    [1500, () => { logActionArea("layout_only"); shotShell("layout_only"); }],
  ],
  // Color and font by nesting level (Appearance): the table, its Property, Color and Font windows, and the Layout tab's View template row with On.
  nestingStyle: [
    [2500, () => clickTab("Layout")],
    [1000, () => showInScroll(button("Leaves in place"))],
    [1000, () => shotShell("layout_template")],
    [100,  () => clickTab("Appearance")],
    [1500, () => { log(`notes: ${notes().join(" | ")}`); shotShell("appearance_nesting"); }],
    [500,  () => openCell(NSTYLE(), 0, "Color")],
    [1500, () => { logPopup("color_window"); shot("color_window", shell.getMonitor().getBounds()); }],
    [100,  () => pressInPopup("Cancel")],
    [800,  () => openCell(NSTYLE(), 1, "Font")],
    [1500, () => { logPopup("font_window"); shot("font_window", shell.getMonitor().getBounds()); }],
    [100,  () => chooseInPopupCombo(0)],
    [1500, () => { logPopup("font_template"); shot("font_template", shell.getMonitor().getBounds()); }],
    [100,  () => pressInPopup("Cancel")],
    [800,  () => openCell(NSTYLE(), 0, "Property")],
    [1500, () => { logPopup("property_window"); shot("property_window", shell.getMonitor().getBounds()); }],
    [100,  () => pressInPopup("Cancel")],
    [100,  () => clickTab("Layout")],
    [800,  () => { showInScroll(button("Leaves in place")); clickControl(button("On")); }],
    [1500, () => shotShell("layout_template_off")],
    [100,  () => clickTab("Appearance")],
    [1500, () => shotShell("appearance_template_off")],
    [500,  () => openCell(NSTYLE(), 0, "Color")],
    [1500, () => { logPopup("color_window_off"); shot("color_window_off", shell.getMonitor().getBounds()); }],
    [100,  () => pressInPopup("OK")],
    [800,  () => openCell(NSTYLE(), 0, "Font")],
    [1500, () => { logPopup("font_window_off"); shot("font_window_off", shell.getMonitor().getBounds()); }],
    [100,  () => pressInPopup("OK")],
