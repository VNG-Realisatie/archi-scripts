/**
 * Measure the View dialog: module load, the work before it opens, building the tabs and the counts.
 * Opens the dialog as _gui.ajs does and logs one table when it closes: calls, total, average and max
 * per label; once shown, it logs the widgets the dialog holds (per SWT class and tab, combo items). The GUI has no measurement code: this script wraps exported functions of the modules it
 * loads. Module objects are shared, so a caller's `Module.fn(…)` goes through the wrapper; private
 * functions and destructured imports are not measured ("dialog open → shown" minus the measured parts).
 *
 * In Archi: select as for _gui.ajs, run this script and close the dialog with Cancel (a run would add its
 * own calls to the table). The dialog opens on the session, as _gui.ajs does.
 * Command line, comparable between machines (no selection there):
 *   SELECT_TYPE  the type of the objects to select, default "element"
 *   SELECT_NAME  their name (a "—" in it is lost on Windows: pick a name without it)
 *   SELECT_ID    instead of SELECT_TYPE / SELECT_NAME: one object by id, the same in every clone of a model
 *   PRESET       the dialog opens on this preset instead of the session (the session differs per machine)
 * The dialog closes as soon as it is shown, as its close button does (Cancel, no run); the session is not saved.
 *   SELECT_ID=id-ba72ad08ad1b475390125ad1938fd298 PRESET="Bestuurscontext/Capability" \
 *     Scripts/View/tools/archi_cli.sh Scripts/View/tools/gui_timing.ajs <model>
 * Plan and reference numbers: plan/view-dialog-open-and-counts-performance.md.
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const System = Java.type("java.lang.System");
const Display = Java.type("org.eclipse.swt.widgets.Display");
const T0 = Date.now();

/** @type {Map<string, { n: number, total: number, max: number }>} */
const stats = new Map();
/** @param {string} label @param {number} ms */
function record(label, ms) {
  const s = stats.get(label) || { n: 0, total: 0, max: 0 };
  s.n++; s.total += ms; s.max = Math.max(s.max, ms);
  stats.set(label, s);
}
/** @template T @param {string} label @param {() => T} fn @returns {T} */
function time(label, fn) {
  const t = Date.now();
  try { return fn(); } finally { record(label, Date.now() - t); }
}

// Module load: leaf-first, so each line costs that module alone (read, parse, top-level code).
// A module missing from this list is counted with the first one that requires it.
const MODULES = [
  "_lib/Common.js", "_lib/archi_folders.js", "_lib/selection.js", "View/lib/rel_filter.js", "View/lib/defs.js",
  "View/lib/preset_io.js", "View/lib/hidden_properties.js", "View/lib/nesting.js",
  "View/lib/selection_pipeline.js", "View/lib/selection_read.js", "chroma-js", "View/lib/palettes.js",
  "View/lib/appearance.js", "View/lib/label_size.js", "View/lib/engines/engine-utils.js",
  "View/lib/layout_graph.js", "View/lib/process_runner.js", "View/lib/engines/registry.js",
  "View/lib/node_layout.js", "View/config.default.js", "View/lib/view_config.js",
  "View/lib/text_measure.js", "View/lib/write_plan.js", "View/lib/view_writer.js",
  "View/lib/view_origin.js", "View/lib/generate_view.js", "View/lib/run_preset.js",
  "View/lib/gui/counts.js", "View/lib/gui/widgets.js", "View/lib/gui/condition_table.js",
  "View/lib/gui/tab_selection.js", "View/lib/gui/tab_appearance.js", "View/lib/gui/tab_layout.js",
  "View/lib/gui/tab_properties.js", "View/lib/gui/dialog_presets.js", "View/lib/gui/preset_row.js",
  "View/lib/gui/dialog_main.js",
];
/** @type {Record<string, any>} */
const mods = {};
for (const m of MODULES) mods[m] = time(`load  ${m}`, () => require(m.endsWith(".js") ? REPO_ROOT + m : m));
record("load  all modules", Date.now() - T0);

// Exported functions to measure, per module. A name that is not a function stops the script, so a
// rename cannot silently drop a measurement. Do not add per-object functions (matchElement, …): the
// wrapper's own cost would show.
const MEASURED = {
  "_lib/selection.js":              ["getSelection"],
  "View/lib/selection_read.js":     ["holdsFolderOrView", "describeVisuals", "readRelationIndex", "readDiagramBlocks", "readSelection"],
  "View/lib/preset_io.js":          ["ensureDefault", "listPresets", "readPreset", "writeSession"],
  "View/lib/gui/preset_row.js":     ["buildPresetRow"],
  "View/lib/gui/tab_selection.js":  ["buildSelectionTab", "addRelatedBlock"],
  "View/lib/gui/tab_layout.js":     ["buildLayoutTab", "updateAlgorithmControls", "updateLayoutConditionCounts"],
  "View/lib/gui/tab_appearance.js": ["buildAppearanceTab", "updateStyleWarnings", "updateNestingLevelState", "updateAppearancePropStates"],
  "View/lib/gui/tab_properties.js": ["buildPropertiesTab", "syncToUI"],
  "View/lib/gui/widgets.js":        ["resizeScrolled"],
  "View/lib/gui/counts.js":         ["dialogCounts"],
  "View/lib/selection_pipeline.js": ["findRelationsBetween", "expandStepWithRelations", "composeObjectSet"],
  "View/lib/nesting.js":            ["splitNestingRels", "resolveNesting", "predictViewCounts", "countView"],
};
for (const [m, names] of Object.entries(MEASURED)) {
  const mod = mods[m];
  const short = m.replace(/^.*\//, "").replace(/\.js$/, "");
  for (const name of names) {
    const fn = mod[name];
    if (typeof fn !== "function") throw new Error(`gui_timing: ${m} exports no function ${name}`);
    mod[name] = function (/** @type {any[]} */ ...args) { return time(`${short}.${name}`, () => fn.apply(this, args)); };
  }
}

const selectName = System.getenv("SELECT_NAME");
const selectId = System.getenv("SELECT_ID");
const commandLine = !!(selectName || selectId);
const presetName = System.getenv("PRESET");
const PresetIO = mods["View/lib/preset_io.js"];
if (presetName) PresetIO.readSession = () => Object.assign(PresetIO.readPreset(String(presetName)), { name: String(presetName) });
if (commandLine) PresetIO.writeSession = () => {};   // the measurement leaves the session as it was

// Widgets at open: every control of the dialog's shell per SWT class, per tab ("other": title area, preset
// row, action area), and the items in its combos and trees. On Win32 each control is a native window, and
// creating or filling one costs window events (plan § Windows: why native widgets are slow).
const Composite = Java.type("org.eclipse.swt.widgets.Composite");
const TabFolder = Java.type("org.eclipse.swt.widgets.TabFolder");
const Combo = Java.type("org.eclipse.swt.widgets.Combo");
const Tree = Java.type("org.eclipse.swt.widgets.Tree");
const OTHER = "other";
/** @param {any} shell */
function countWidgets(shell) {
  /** @type {Map<string, Map<string, number>>} kind → part → count */
  const counts = new Map();
  /** @type {string[]} */
  const parts = [];
  /** @type {number[]} */
  const comboItems = [];
  const add = (/** @type {string} */ kind, /** @type {string} */ part, /** @type {number} */ n) => {
    if (!counts.has(kind)) counts.set(kind, new Map());
    const k = /** @type {Map<string, number>} */ (counts.get(kind));
    k.set(part, (k.get(part) || 0) + n);
    if (!parts.includes(part)) parts.push(part);
  };
  const walk = (/** @type {any} */ c, /** @type {string} */ part) => {
    add(String(c.getClass().getSimpleName()), part, 1);
    if (!c.getVisible()) add("(hidden: own setVisible(false))", part, 1);
    if (c instanceof Combo) { comboItems.push(c.getItemCount()); add("(combo items)", part, c.getItemCount()); }
    if (c instanceof Tree) add("(tree items, top level)", part, c.getItemCount());
    if (!(c instanceof Composite)) return;
    const tabs = c instanceof TabFolder ? c.getItems() : [];
    for (const child of c.getChildren()) {
      const tab = tabs.find((/** @type {any} */ t) => t.getControl() === child);
      walk(child, tab ? String(tab.getText()) : part);
    }
  };
  walk(shell, OTHER);
  parts.push(parts.splice(parts.indexOf(OTHER), 1)[0]);   // "other" last
  console.log("");
  console.log(`Widgets at open, per tab   ${["total", ...parts].map(p => p.padStart(11)).join("")}`);
  const kinds = [...counts.keys()].sort((a, b) => (a.startsWith("(") ? 1 : 0) - (b.startsWith("(") ? 1 : 0) || a.localeCompare(b));
  let controls = 0;
  for (const kind of kinds) {
    const k = /** @type {Map<string, number>} */ (counts.get(kind));
    const total = [...k.values()].reduce((a, b) => a + b, 0);
    if (!kind.startsWith("(")) controls += total;
    console.log(`  ${kind.padEnd(25)}${[total, ...parts.map(p => k.get(p) || 0)].map(n => String(n).padStart(11)).join("")}`);
  }
  console.log(`  ${"controls in total".padEnd(25)}${String(controls).padStart(11)}`);
  const bands = [[0, 0], [1, 1], [2, 9], [10, 49], [50, Infinity]];
  console.log(`  combos by item count: ${bands.map(([lo, hi]) => `${hi === Infinity ? `${lo}+` : lo === hi ? lo : `${lo}–${hi}`}: ${comboItems.filter(n => n >= lo && n <= hi).length}`).join(" · ")}`
    + ` · max ${Math.max(0, ...comboItems)}`);
}

// Dialog open → shown: the first runnable of the dialog's event loop, queued when the last tab is built.
// Then count its widgets; command line: close it as its close button does (Cancel).
let tOpen = 0;
const TabProperties = mods["View/lib/gui/tab_properties.js"];
const buildPropertiesTab = TabProperties.buildPropertiesTab;
TabProperties.buildPropertiesTab = function (/** @type {any} */ tabFolder, /** @type {any} */ ctx) {
  const r = buildPropertiesTab(tabFolder, ctx);
  tabFolder.getDisplay().asyncExec(() => {
    record("dialog open → shown", Date.now() - tOpen);
    countWidgets(tabFolder.getShell());
    if (commandLine) for (const sh of Display.getDefault().getShells()) if (sh.getData()) sh.close();
  });
  return r;
};

const Common = mods["_lib/Common.js"];
Common.initConsoleLog(__FILE__, true);

let uiSelection = $(selection);
if (commandLine) {   // no selection and no workbench shell
  uiSelection = selectId ? $(`#${selectId}`)
    : $(String(System.getenv("SELECT_TYPE") || "element")).filter(o => o.name === String(selectName));
  globalThis.shell = null;
}
/** @type {number} */
let objectsOnViews = 0;
uiSelection.filter("archimate-diagram-model").each(v => { objectsOnViews += $(v).find().size(); });
console.log(`Measured: ${System.getProperty("os.name")} · model "${model.name}" · preset ${presetName ? `"${presetName}"` : "session"}`
  + ` · selection ${uiSelection.size()} object(s)${objectsOnViews ? `, ${objectsOnViews} objects on its views` : ""}`);

tOpen = Date.now();
try { mods["View/lib/gui/dialog_main.js"].open(uiSelection); }
catch (e) { mods["View/lib/run_preset.js"].showFailure(e); }

console.log("");
console.log("   calls    total      avg      max  (ms)");
const pad = (/** @type {number} */ v) => String(Math.round(v)).padStart(8);
for (const [label, s] of stats) console.log(`${pad(s.n)} ${pad(s.total)} ${pad(s.total / s.n)} ${pad(s.max)}  ${label}`);
Common.finishConsoleLog();
