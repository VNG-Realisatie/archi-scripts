/**
 * Entry point: open the View Generation GUI.
 *
 * Captures the Archi UI selection before the dialog opens (opening a dialog
 * causes focus loss which clears the selection in some jArchi versions).
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();

const Common = require(REPO_ROOT + "_lib/Common");
Common.initConsoleLog(__FILE__, true);

const initialSelection = $(selection);

const Dialog = require(REPO_ROOT + "View/lib/gui/dialog_main");
Dialog.open(initialSelection);
