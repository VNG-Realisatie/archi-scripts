/**
 * Test: does jArchi reset visual properties when vo.bounds is set?
 *
 * Select a view that has at least one element with custom colors/fonts, then run.
 * Results are logged to the Archi console.
 *
 * Scenarios per VisualElement:
 *   A — same size, position shifted +20px
 *   B — larger size (+20px each), position shifted +40px
 *   C — original bounds restored
 */
(function() {

const VISUAL_PROPS = ["fillColor", "lineColor", "fontColor", "fontSize", "fontName", "fontStyle", "opacity"];

const view = $(selection).filter("archimate-diagram-model").first();
if (!view) { console.log("ERROR: Select a view first."); return; }

console.log(`Testing view: "${view.name}"`);

let passed = 0, failed = 0, skipped = 0;

$(view).find("element").each(ve => {
  const name = (ve.concept && ve.concept.name) || "(unnamed)";

  const original   = {};
  const origBounds = { x: ve.bounds.x, y: ve.bounds.y, width: ve.bounds.width, height: ve.bounds.height };
  VISUAL_PROPS.forEach(p => { try { const v = ve[p]; if (v !== undefined) original[p] = v; } catch(e) {} });

  const customProps = Object.keys(original).filter(p => original[p] !== null && original[p] !== undefined);
  if (customProps.length === 0) { skipped++; return; }

  console.log(`\n── Element: "${name}"`);
  customProps.forEach(p => console.log(`   ${p}: ${original[p]}`));

  function checkAfter(scenario) {
    let anyChanged = false;
    VISUAL_PROPS.forEach(p => {
      let after;
      try { after = ve[p]; } catch(e) { return; }
      const before = original[p];
      if (before === undefined) return;
      if (String(after) !== String(before)) {
        console.log(`   [${scenario}] CHANGED: ${p}  was "${before}"  now "${after}"`);
        anyChanged = true;
        failed++;
      }
    });
    if (!anyChanged) {
      console.log(`   [${scenario}] OK — no properties changed`);
      passed++;
    }
  }

  // A: same size, move +20
  ve.bounds = { x: origBounds.x + 20, y: origBounds.y + 20,
                width: origBounds.width, height: origBounds.height };
  checkAfter("A: move only (+20)");

  // B: larger size, move +40
  ve.bounds = { x: origBounds.x + 40, y: origBounds.y + 40,
                width: origBounds.width + 20, height: origBounds.height + 20 };
  checkAfter("B: resize +20, move +40");

  // C: restore original
  ve.bounds = origBounds;
  checkAfter("C: restore original");
});

console.log(`\n══ Result: ${passed} OK · ${failed} CHANGED · ${skipped} skipped (no custom props) ══`);
if (failed === 0) {
  console.log("Visual properties are NOT reset by bounds changes.");
  console.log("→ Safe to remove _VISUAL_PROPS save/restore from _applyResultToView.");
} else {
  console.log("Visual properties ARE reset in some scenarios.");
  console.log("→ Keep _VISUAL_PROPS save/restore in _applyResultToView.");
}

})();
