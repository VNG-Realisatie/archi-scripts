/*
 * plotNoteStatus
 *
 * Plot a note with the text of a property on top of an element
 *
 * (c) 2019 Mark Backer
 *
 */
if (typeof require !== "function") { const m = "This script needs jArchi 1.11 or later, with CommonJS on: in Archi, open Preferences > Scripting and tick \"Enable CommonJS Support\" (no such option: update jArchi first). Then run the script again."; try { window.alert(m); } catch (e) { console.error(m); } exit(); }
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Log    = require(REPO_ROOT + "_lib/log");
const Selection = require(REPO_ROOT + "_lib/selection.js");

Log.start(__FILE__, true);

let collection = Selection.getVisualSelection($(selection));
Selection.applyToCollection(collection, plotNoteStatus);

Log.finish();

function plotNoteStatus(obj) {
	if (obj.prop("GEMMA status") == "In ontwikkeling") {
		// Add a Note to this element
		var note = obj.createObject("note", 10, 30, 180, 25);
		note.fillColor = obj.fillColor;
		note.fontSize = 8;
		// note.fontStyle = "bold";

		note.text = `(Nog) niet opgenomen in SWC`;
		console.log(`- ${obj.name}, view "${obj.view.name}"`);
	}
}
