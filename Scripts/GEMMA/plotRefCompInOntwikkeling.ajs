/*
 * plotNoteStatus
 *
 * Plot a note with the text of a property on top of an element
 *
 * (c) 2019 Mark Backer
 *
 */
const Common = require(__SCRIPTS_DIR__ + "Scripts/_lib/Common.js");
const Selection = require(__SCRIPTS_DIR__ + "Scripts/_lib/selection.js");

Common.initConsoleLog(__FILE__, true);

let collection = Selection.getVisualSelection($(selection));
Selection.applyToCollection(collection, plotNoteStatus);

Common.finishConsoleLog();

function plotNoteStatus(obj) {
	if (obj.prop("GEMMA status") == "In ontwikkeling") {
		// Add a Note to this element
		var note = obj.createObject("note", 10, 30, 180, 25);
		note.fillColor = obj.fillColor;
		note.fontSize = 8;
		// note.fontStyle = "bold";

		note.text = `(Nog) niet opgenomen in SWC`;
		console.log(`- ${obj.name}, view "${obj.view.name}"`);
	}
}
