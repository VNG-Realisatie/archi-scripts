/**
 * Genereer de views van de GGM data-objecten en de GEMMA bedrijfsobjecten
 *
 * Configuratie van de te genereren views in
 * - GGM/user_parameter/ggmDO.js en
 * - GGM/user_parameter/ggmBO.js
 *
 * Hoe te gebruiken:
 * - selecteer één of meerdere Beleidsdomeinen
 * - draai dit script
 *
 * Dit script
 * - genereert van ieder beleidsdomein een view van de data-objecten en een view van de bedrijfsobjecten
 * - styled de views
 * - set de eigenschappen van de views
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common.js");
const Selection = require(REPO_ROOT + "_lib/selection.js");
const View = require(REPO_ROOT + "View/include_view.js");

const GgmGemma = require(__DIR__ + "include_ggm_gemma.js");

const FOLDER_SYNC_GGM_VIEWS = GgmGemma.FOLDER_SYNC_GGM + "/GGM naar GEMMA";

Common.initConsoleLog(__FILE__, true);

try {
  let GEMMA_Beleidsdomeinen = Selection.getSelection($(selection), "grouping");
  GEMMA_Beleidsdomeinen = GEMMA_Beleidsdomeinen.filter(
    (grouping) =>
      grouping.prop(GgmGemma.PROP_GEMMA_TYPE) == GgmGemma.GEMMA_TYPE_BELEIDSDOMEIN &&
      grouping.prop(GgmGemma.PROP_GEMMA_GGM_STATUS) != GgmGemma.GEMMA_GGM_STATUS_LEEG,
  );

  console.log();
  if (GEMMA_Beleidsdomeinen.size() < 1) {
    console.log("Geen beleidsdomeinen geselecteerd, selecteer één of meer beleidsdomeinen");
  } else {
    console.log(`\nGenereer GGM data-objectmodellen`);
    console.log(`==============================`);
    
    let param = View.read_user_parameter(__FILE__, "ggmDO", "GenerateMultiple", "LR");
    param.viewFolder = GgmGemma.FOLDER_GGM_DATAOBJECT;
    param.viewNameSuffix = GgmGemma.VIEW_NAME_SUFFIX;
    let generatedViews = View.generate_view(param, GEMMA_Beleidsdomeinen);
    styleLabelsProperties(generatedViews);

    console.log();
    console.log(`\nGenereer GEMMA bedrijfsobjectmodellen`);
    console.log(`=====================================`);
    
    param = View.read_user_parameter(__FILE__, "ggmBO", "GenerateMultiple", "LR");
    param.viewFolder = FOLDER_SYNC_GGM_VIEWS + GgmGemma.FOLDER_BEDRIJFSOBJECT;
    generatedViews = View.generate_view(param, GEMMA_Beleidsdomeinen);
    styleLabelsProperties(generatedViews);
  }
  console.log();
} catch (error) {
  console.log(`> ${typeof error.stack == "undefined" ? error : error.stack}`);
}

Common.finishConsoleLog();

/**
 *
 * @param {Archi collection} views
 */
function styleLabelsProperties(views) {
  console.log(`\nStyling, labels and properties`);
  console.log(`==============================`);
  Common.debug(`views: ${views}`);

  console.log("\nStyle view");
  styleView(views);
  console.log("\nSet view properties");
  setLabelBeleidsdomein(views);
  console.log("\nUpdate view properties");
  views.each((view) => GgmGemma.updateViewProp(view));
}

/**
 * Append (<Beleidsdomein>) to a visual objects label
 */
function setLabelBeleidsdomein(views) {
  // toon label Beleidsdomein voor data- of bedrijfsobjecten die niet in een Beleidsdomein zijn genest
  let notNestedElements = views.children("element").not("grouping");
  notNestedElements.each((obj) => (obj.labelExpression = "${name}\n($aggregation:source{name})"));
}

/**
 * Styling functions
 */
function styleView(views) {
  console.log();

  // kleur voor onderscheid op PROP_ARCHIMATE_TYPE (data- en bedrijfsobject)
  applyToCollection(Selection.getVisualSelection(views, "data-object"), styleDataObjects);
  console.log();

  // tekst in het midden
  applyToCollection(Selection.getVisualSelection(views, "business-object"), styleBusinessObjects);
  console.log();

  // bold font domein-grouping
  applyToCollection(Selection.getVisualSelection(views, "grouping"), styleGroupings);
  console.log();

  // specialisatie-relaties groen
  applyToCollection(Selection.getVisualSelection(views, "specialization-relationship"), styleSpecialization);
  console.log();
}

function applyToCollection(collection, fn) {
  collection.each((obj) => fn(obj));
}

function styleDataObjects(obj) {
  obj.textPosition = TEXT_POSITION.CENTER;
  switch (obj.prop(GgmGemma.PROP_ARCHIMATE_TYPE)) {
    case "Data object":
      obj.opacity = 255;
      obj.gradient = GRADIENT.NONE;
      obj.fillColor = null; // default color blue
      break;
    case "Business object":
      obj.opacity = 200;
      obj.gradient = GRADIENT.LEFT;
      obj.fillColor = "#FFFFCC"; // "Cream"
      break;

    default:
      obj.opacity = 255;
      obj.gradient = GRADIENT.NONE;
      obj.fillColor = "#C0C0C0"; // "Silver"
      break;
  }
  if (obj.prop(GgmGemma.PROP_GGM_UML_TYPE) == "Enumeration") {
    obj.opacity = 100;
    obj.labelExpression = `\${name}\n<<\${property:${GgmGemma.PROP_GGM_UML_TYPE}}>>`;
  }
}

function styleBusinessObjects(obj) {
  obj.textPosition = TEXT_POSITION.CENTER;
}

function styleGroupings(obj) {
  obj.fontSize = 12;
  obj.fontStyle = "bold";
  obj.textAlignment = TEXT_ALIGNMENT.LEFT;
  obj.fillColor = "#FAFAFA";
}

function styleSpecialization(obj) {
  obj.lineColor = "#5DADE2"; // Set the line color to blue
  obj.lineWidth = 2;
}
