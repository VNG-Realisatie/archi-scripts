/**
 * Wrapper file for generating and/or layout a view
 *
 * The filename defines which parameter are used
 * Format of the filename:
 * - <user parameter filename>_<action>_<direction>.ajs
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common.js");
const Selection = require(REPO_ROOT + "_lib/selection.js");
const ArchiFolders = require(REPO_ROOT + "_lib/archi_folders.js");
const View = require(REPO_ROOT + "View/include_view_presets.js");
const GgmGemma = require(__DIR__ + "include_ggm_gemma.js");

Common.initConsoleLog(__FILE__, true);

let param = {};
param = View.get_default_parameter(__FILE__);
param = View.get_user_parameter(__FILE__, param);

View.generate_view(param);
Common.finishConsoleLog();