/**
 * Import GGM Beleidsdomeinen in GEMMA-GGM Archi-repository
 *
 * This script imports GGM "iv3-domeinen" as groupings with GGM types "Beleidsdomein".
 * Also tags deleted beleidsdomeinen.
 */
const Common = require(__SCRIPTS_DIR__ + "Scripts/_lib/Common.js");
const GgmGemma = require(__DIR__ + "include_ggm_gemma.js");
const Sync = require(__SCRIPTS_DIR__ + "Scripts/Sync from CSV/Include_LoadAndSync.js");
const Config = require(__DIR__ + "config.default.js");
const GgmImport = require(__DIR__ + "include_ggm_import.js");

Common.initConsoleLog(__FILE__, true);

try {
  const importFile = GgmImport.getImportFile(Config);
  if (!importFile) {
    console.log("> Canceled");
  } else {
    const importConfig = GgmImport.getConfiguration(importFile);

    console.log("Start of synchronization Beleidsdomeinen...");
    Sync.loadAndSync(importConfig.beleidsdomeinen);

    // Tag deleted beleidsdomeinen
    let GGM_beleidsdomeinen = $("grouping").filter(
      (group) => group.prop(GgmGemma.PROP_GGM_TYPE) == GgmGemma.GEMMA_TYPE_BELEIDSDOMEIN,
    );
    Sync.tagDeletedConcepts(GGM_beleidsdomeinen);

    console.log("End of synchronization Beleidsdomeinen.");
  }
} catch (error) {
  console.log(`> ${typeof error.stack == "undefined" ? error : error.stack}`);
}

Common.finishConsoleLog();
