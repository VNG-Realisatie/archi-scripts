if (typeof require !== "function") { const m = "This script needs jArchi 1.11 or later, with CommonJS on: in Archi, open Preferences > Scripting and tick \"Enable CommonJS Support\" (no such option: update jArchi first). Then run the script again."; try { window.alert(m); } catch (e) { console.error(m); } exit(); }
const Chroma = require("chroma-js");
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Log    = require(REPO_ROOT + "_lib/log");
const Selection = require(REPO_ROOT + "_lib/selection.js");

Log.start(__FILE__, true);

try {
	let collection = Selection.getVisualSelection($(selection), "application-component");
	Selection.applyToCollection(collection, ColorBy, ["Vertrouwelijkheid", "Blues"]);
} catch (error) {
	console.log(`> ${typeof error.stack == "undefined" ? error : error.stack}`);
}

Log.finish();

/**
 * ColorByVertrouwelijkheid
 *	 Color elements of the same type by the value of a given property
 */
function ColorBy(obj, args) {
	let prop = args[0];
	let chromaColor = args[1];

	if (typeof this.only_once == "undefined") {
		this.colors = Chroma.scale(chromaColor).padding([0.15, 0.3]);
		console.log(`Color elements with shades of ${chromaColor}, varied by the value of ${prop}`);
		this.only_once = true;
	}

	if (obj.prop(prop)) {
		console.log(`- ${obj.name}, view "${obj.view.name}", color by ${prop}=${obj.prop(prop)}`);
		colorShade = this.colors((obj.prop(prop) - 0.8) / 3);
		obj.fillColor = `${colorShade}`;
	} else {
		console.log(`> Skipped: ${obj}, view "${obj.view.name}"`);
	}
}
