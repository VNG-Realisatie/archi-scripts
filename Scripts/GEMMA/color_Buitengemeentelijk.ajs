/**
 * Color all "Buitengemeentelijke voorzieningen"
 * - getVisualSelection() return a collection of visual objects
 *
 * (c) 2023 Mark Backer
 *
 */
const Chroma = require("chroma-js");
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common.js");
const Selection = require(REPO_ROOT + "_lib/selection.js");

Common.initConsoleLog(__FILE__, true);

let colors = Chroma.scale("Blues"); //.padding([0.1, 0.4]);
let colorShade = colors(0.0);

try {
	// Given a selection, create a collection of all visual objects 
  let collection = Selection.getVisualSelection($(selection), "application-component");
  collection.each((obj) => {
    if (obj.prop("GEMMA type") == "Buitengemeentelijke voorziening") {
      console.log(`- view "${obj.view.name}", \t${obj.name} `);
      obj.fillColor = `${colorShade}`;
    }
  });
} catch (error) {
  console.log(`> ${typeof error.stack == "undefined" ? error : error.stack}`);
}

Common.finishConsoleLog();
