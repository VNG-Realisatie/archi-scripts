/*
 * plotObjectID.ajs
 *   plot a note with the GEMMA Object ID in selected elements
 *
 * (c) 2022 Mark Backer
 *
 */
const Common = require(__DIR__ + "/../_lib/Common.js");
const Selection = require(__DIR__ + "/../_lib/selection.js");

Common.initConsoleLog(__FILE__, true);

const PROP_ID = "Object ID";

// select visual elements
let collection = Selection.getVisualSelection($(selection), "element");
Selection.applyToCollection(collection, plotID);

Common.finishConsoleLog();

function plotID(obj) {
  // console.log(`- ${obj}`);

  // plot a note on this element
  var note = obj.createObject("note", 5, 35, 190, 24);
  note.fontSize = 6;
  note.textPosition = TEXT_POSITION.CENTER;
  note.borderType = BORDER.RECTANGLE;
  // use id of concept, not id of occurrence
  note.text = `${obj.concept.prop(PROP_ID)}`;
}
