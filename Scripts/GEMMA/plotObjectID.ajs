/*
 * plotObjectID.ajs
 *   plot a note with the GEMMA Object ID in selected elements
 *
 * (c) 2022 Mark Backer
 *
 */
if (typeof require !== "function") { const m = "This script needs jArchi 1.11 or later, with CommonJS on: in Archi, open Preferences > Scripting and tick \"Enable CommonJS Support\" (no such option: update jArchi first). Then run the script again."; try { window.alert(m); } catch (e) { console.error(m); } exit(); }
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Log    = require(REPO_ROOT + "_lib/log");
const Selection = require(REPO_ROOT + "_lib/selection.js");

Log.start(__FILE__, true);

const PROP_ID = "Object ID";

// select visual elements
let collection = Selection.getVisualSelection($(selection), "element");
Selection.applyToCollection(collection, plotID);

Log.finish();

function plotID(obj) {
  // console.log(`- ${obj}`);

  // plot a note on this element
  var note = obj.createObject("note", 5, 35, 190, 24);
  note.fontSize = 6;
  note.textPosition = TEXT_POSITION.CENTER;
  note.borderType = BORDER.RECTANGLE;
  // use id of concept, not id of occurrence
  note.text = `${obj.concept.prop(PROP_ID)}`;
}
