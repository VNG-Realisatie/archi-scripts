/**
 * Remove all bendpoints from selected relationships
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common");

Common.initConsoleLog(__FILE__, true);

let viewObjects;
if ($(selection).is("view")) {
  viewObjects = $(selection).find();
} else if ($(selection).first() && $(selection).first().view) {
  viewObjects = $(selection);
} else {
  console.log("Selection not valid, select a view or select objects on a view");
}

if (viewObjects) {
  viewObjects
    .filter("relationship")
    .filter(function (o) {
      return o.id != o.concept.id;
    })
    .each(function (o) {
      o.deleteAllBendpoints();
    });
}

Common.finishConsoleLog();
