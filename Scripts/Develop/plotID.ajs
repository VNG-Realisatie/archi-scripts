/*
 * plot a note with the Archi id in selected elements
 *
 * (c) 2019 Mark Backer
 *
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Selection = require(REPO_ROOT + "_lib/selection.js");

// select visual elements
let collection = Selection.getVisualSelection($(selection), "element");
Selection.applyToCollection(collection, plotID);
console.log("Script finished\n");

function plotID(obj) {
  // console.log(`- ${obj}`);

  // plot a note on this element
  var note = obj.createObject("note", 5, 40, 190, 19);
  note.fontSize = 5;
  note.textPosition = TEXT_POSITION.CENTER;
  note.borderType = BORDER.RECTANGLE;
  // use id of concept, not id of occurrence
  note.text = `${obj.concept.id}`;
}
