/**
 * deleteUnusedElements
 */

const Common = require(__SCRIPTS_DIR__ + "Scripts/_lib/Common.js");
const Selection = require(__SCRIPTS_DIR__ + "Scripts/_lib/selection.js");

Common.initConsoleLog(__FILE__, true);

let collection = Selection.getSelection($(selection));
Selection.applyToCollection(collection.filter("element"), deleteUnusedElements);

Common.finishConsoleLog();

function deleteUnusedElements(obj) {
	if ($(obj.concept).objectRefs().isEmpty()) {
		console.log("- Delete: " + obj.name);
		obj.delete();
	}
}
