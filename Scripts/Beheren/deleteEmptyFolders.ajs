/**
 * delete empty folders
 */

const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Common = require(REPO_ROOT + "_lib/Common.js");
const ArchiFolders = require(REPO_ROOT + "_lib/archi_folders.js");

Common.initConsoleLog(__FILE__, true);
try {
  let nrFoldersStart = $(model).find("folder").size();

  console.log(`\nDelete empty folders:`);
  ArchiFolders.deleteEmptyFolders($(model).first());

  let nrFoldersRemaining = $(model).find("folder").size();
  console.log(`Deleted ${nrFoldersStart - nrFoldersRemaining} empty folders of total of ${nrFoldersStart} folders`);
} catch (error) {
  console.error(`> ${typeof error.stack == "undefined" ? error : error.stack}`);
}
Common.finishConsoleLog();
