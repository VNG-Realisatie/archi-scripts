/**
 * 	add a property to selected objects
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();

if (typeof require !== "function") { const m = "This script needs jArchi 1.11 or later, with CommonJS on: in Archi, open Preferences > Scripting and tick \"Enable CommonJS Support\" (no such option: update jArchi first). Then run the script again."; try { window.alert(m); } catch (e) { console.error(m); } exit(); }
const Log    = require(REPO_ROOT + "_lib/log");
const Selection = require(REPO_ROOT + "_lib/selection.js");

Log.start(__FILE__, true);

let propName = window.prompt("Please enter property", "propertyName");
let propValue = window.prompt(`Value for ${propName}`, "propertyValue");

let collection = Selection.getSelection($(selection), "concept");
Selection.applyToCollection(collection, addProperty, [propName, propValue]);

Log.finish();

function addProperty(obj, args) {
  let propName = args[0];
  let propValue = args[1];

  if (obj.prop(propName)) {
    console.log(`- ${obj} => ${propName}=${obj.prop(propName, true)} updated with ${propValue}`);
  }
  obj.prop(propName, propValue, false);
}
