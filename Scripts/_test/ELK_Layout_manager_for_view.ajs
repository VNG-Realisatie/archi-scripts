/*
 * JArchi Script - Complete Layout Manager with SWT Interface
 * 
 * Single script with native dialog to manage all layout types
 * Full graphical interface with tabs
 */

console.clear();
console.show();

// Check that a view is selected
var view = selection.filter("archimate-diagram-model").first();

if (!view) {
    window.alert("Please select an ArchiMate view");
    exit();
}

console.log("=== Complete Layout Manager - " + view.name + " ===");

// Import SWT classes
const SWT = Java.type('org.eclipse.swt.SWT');
const LabelWidget = Java.type('org.eclipse.swt.widgets.Label');
const CompositeWidget = Java.type('org.eclipse.swt.widgets.Composite');
const SpinnerWidget = Java.type('org.eclipse.swt.widgets.Spinner');
const GroupWidget = Java.type('org.eclipse.swt.widgets.Group');
const ButtonWidget = Java.type('org.eclipse.swt.widgets.Button');
const ComboWidget = Java.type('org.eclipse.swt.widgets.Combo');
const TabFolderWidget = Java.type('org.eclipse.swt.widgets.TabFolder');
const TabItemWidget = Java.type('org.eclipse.swt.widgets.TabItem');
const GridDataFactory = Java.type('org.eclipse.jface.layout.GridDataFactory');
const GridLayoutFactory = Java.type('org.eclipse.jface.layout.GridLayoutFactory');
const RowLayout = Java.type('org.eclipse.swt.layout.RowLayout');
const GridData = Java.type('org.eclipse.swt.layout.GridData');
const IMessageProvider = Java.type('org.eclipse.jface.dialogs.IMessageProvider');
const TitleAreaDialog = Java.type("org.eclipse.jface.dialogs.TitleAreaDialog");

const ConfigDialog = Java.extend(TitleAreaDialog);

// Analyze the view
function analyzeView() {
    var elements = [];
    var rels = [];
    
    $(view).find().each(function(child) {
        if (child.bounds) elements.push(child);
    });
    
    $(view).find("relationship").each(function(rel) {
        rels.push(rel);
    });
    
    var density = elements.length > 0 ? rels.length / elements.length : 0;
    
    return {
        elements: elements.length,
        relations: rels.length,
        density: density,
        recommendation: getRecommendation(elements.length, density)
    };
}

function getRecommendation(elemCount, density) {
    if (elemCount < 10) return "Compact or Standard";
    if (elemCount < 30) return "Standard";
    if (density > 0.5) return "Spacious + Anti-overlap";
    return "Spacious";
}

var stats = analyzeView();

// Dialog configuration
let layoutDialog = {
    
    // Complete configuration
    config: {
        // Layout type
        layoutType: "Hierarchical",
        layoutTypes: ["Hierarchical", "Grid", "Circular", "Vertical", "Horizontal"],
        
        // Presets
        preset: "Standard",
        presets: ["Compact", "Standard", "Spacious", "Presentation", "Custom"],
        
        // Basic spacing
        hSpacing: 100,
        vSpacing: 80,
        marginTop: 50,
        marginLeft: 50,
        
        // Anti-overlap options
        edgeNodeSpacing: 45,
        edgeEdgeSpacing: 20,
        routingType: "ORTHOGONAL",
        routingTypes: ["ORTHOGONAL (recommended)", "POLYLINE (compact)", "SPLINES (curves)", "None"],
        
        // Advanced options
        optimizeCrossings: true,
        favorStraightEdges: true,
        centerLevels: false,
        thoroughness: 10,
        
        // Circular options
        circularRadius: 250,
        
        // Grid options
        gridColumns: 0  // 0 = auto
    },
    
    widgets: {},
    
    createWidget: function(name, widgetClass, container, label, init, flags) {
        if (flags === undefined) flags = SWT.BORDER;
        
        if (label != null) {
            let txt = new LabelWidget(container, SWT.NONE);
            txt.setText(label);
            GridDataFactory.fillDefaults().align(SWT.END, SWT.CENTER).applyTo(txt);
        }
        
        let widget = new widgetClass(container, flags);
        if (init != null) init(widget);
        if (name != null) this.widgets[name] = widget;
        
        return widget;
    },
    
    applyPreset: function(presetName) {
        var presets = {
            "Compact": { 
                h: 50, v: 40, mt: 30, ml: 30, 
                edgeNode: 30, edgeEdge: 15 
            },
            "Standard": { 
                h: 100, v: 80, mt: 50, ml: 50, 
                edgeNode: 45, edgeEdge: 20 
            },
            "Spacious": { 
                h: 150, v: 120, mt: 80, ml: 80, 
                edgeNode: 60, edgeEdge: 30 
            },
            "Presentation": { 
                h: 120, v: 100, mt: 100, ml: 100, 
                edgeNode: 50, edgeEdge: 25 
            },
            "Custom": { 
                h: 100, v: 80, mt: 50, ml: 50, 
                edgeNode: 45, edgeEdge: 20 
            }
        };
        
        var preset = presets[presetName] || presets["Standard"];
        
        if (this.widgets.spinHSpacing) {
            this.widgets.spinHSpacing.setSelection(preset.h);
            this.widgets.spinVSpacing.setSelection(preset.v);
            this.widgets.spinMarginTop.setSelection(preset.mt);
            this.widgets.spinMarginLeft.setSelection(preset.ml);
            this.widgets.spinEdgeNode.setSelection(preset.edgeNode);
            this.widgets.spinEdgeEdge.setSelection(preset.edgeEdge);
        }
    },
    
    saveInput: function() {
        function getRadioGroupSelectedValue(group) {
            for (let r of group.getChildren()) {
                if (r.getSelection()) {
                    return r.getText();
                }
            }
            return null;
        }
        
        // Type and preset
        this.config.layoutType = this.widgets.comboLayout.getText();
        this.config.preset = getRadioGroupSelectedValue(this.widgets.grpPreset);
        
        // Routing
        var routingText = this.widgets.comboRouting.getText();
        if (routingText.indexOf("ORTHOGONAL") >= 0) this.config.routingType = "ORTHOGONAL";
        else if (routingText.indexOf("POLYLINE") >= 0) this.config.routingType = "POLYLINE";
        else if (routingText.indexOf("SPLINES") >= 0) this.config.routingType = "SPLINES";
        else this.config.routingType = "NONE";
        
        // Spacing
        this.config.hSpacing = parseInt(this.widgets.spinHSpacing.getText(), 10);
        this.config.vSpacing = parseInt(this.widgets.spinVSpacing.getText(), 10);
        this.config.marginTop = parseInt(this.widgets.spinMarginTop.getText(), 10);
