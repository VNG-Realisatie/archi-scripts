};

// Open dialog
const OK = layoutDialog.open();

if (!OK) {
    console.log("Operation cancelled");
    exit();
}

// Get configuration
var config = layoutDialog.config;
console.log("=== Selected Configuration ===");
console.log("Type: " + config.layoutType);
console.log("Preset: " + config.preset);
console.log("Spacing: H=" + config.hSpacing + "px, V=" + config.vSpacing + "px");
console.log("Anti-overlap: " + config.routingType);
console.log("Options: Optimize=" + config.optimizeCrossings);

// ══════════════════════════════════════════════════════════════
// Layout Functions
// ══════════════════════════════════════════════════════════════

function getVisualElements() {
    var elements = [];
    $(view).find().each(function(child) {
        if (child.bounds) {
            elements.push({
                element: child,
                bounds: child.bounds
            });
        }
    });
    return elements;
}

function getRelationships() {
    var relationships = [];
    $(view).find("relationship").each(function(rel) {
        relationships.push({
            relation: rel,
            source: rel.source,
            target: rel.target
        });
    });
    return relationships;
}

function buildDependencyGraph(elements, relationships) {
    var graph = {};
    
    elements.forEach(function(elem, index) {
        var id = elem.element.id;
        graph[id] = {
            element: elem.element,
            outgoing: [],
            incoming: [],
            level: -1,
            position: index
        };
    });
    
    relationships.forEach(function(rel) {
        var sourceId = rel.source.id;
        var targetId = rel.target.id;
        
        if (graph[sourceId] && graph[targetId]) {
            graph[sourceId].outgoing.push(targetId);
            graph[targetId].incoming.push(sourceId);
        }
    });
    
    return graph;
}

function calculateLevels(graph) {
    var levels = [];
    var visited = {};
    var queue = [];
    
    for (var id in graph) {
        if (graph[id].incoming.length === 0) {
            graph[id].level = 0;
            queue.push(id);
            visited[id] = true;
        }
    }
    
    while (queue.length > 0) {
        var currentId = queue.shift();
        var currentLevel = graph[currentId].level;
        
        if (!levels[currentLevel]) {
            levels[currentLevel] = [];
        }
        levels[currentLevel].push(graph[currentId]);
        
        graph[currentId].outgoing.forEach(function(targetId) {
            if (!visited[targetId]) {
                var maxLevel = currentLevel + 1;
                graph[targetId].incoming.forEach(function(sourceId) {
                    if (visited[sourceId]) {
                        maxLevel = Math.max(maxLevel, graph[sourceId].level + 1);
                    }
                });
                
                graph[targetId].level = maxLevel;
                visited[targetId] = true;
                queue.push(targetId);
            }
        });
    }
    
    for (var id in graph) {
        if (!visited[id]) {
            graph[id].level = levels.length;
            if (!levels[levels.length]) {
                levels[levels.length] = [];
            }
            levels[levels.length - 1].push(graph[id]);
        }
    }
    
    return levels;
}

// Hierarchical Layout
function layeredLayout() {
    console.log("Applying hierarchical layout...");
    
    var elements = getVisualElements();
    var relationships = getRelationships();
    var graph = buildDependencyGraph(elements, relationships);
    var levels = calculateLevels(graph);
    
    console.log("Number of levels: " + levels.length);
    
    var currentY = config.marginTop;
    
    levels.forEach(function(level, levelIndex) {
        var maxHeight = 0;
        var currentX = config.marginLeft;
        
        // Crossing optimization
        if (config.optimizeCrossings && levelIndex > 0) {
            level.sort(function(a, b) {
                var aAvgX = 0, bAvgX = 0, aCount = 0, bCount = 0;
                
                a.incoming.forEach(function(srcId) {
                    if (graph[srcId].level === levelIndex - 1) {
                        aAvgX += graph[srcId].element.bounds.x;
                        aCount++;
                    }
                });
                
                b.incoming.forEach(function(srcId) {
                    if (graph[srcId].level === levelIndex - 1) {
                        bAvgX += graph[srcId].element.bounds.x;
                        bCount++;
                    }
                });
                
                aAvgX = aCount > 0 ? aAvgX / aCount : 0;
                bAvgX = bCount > 0 ? bAvgX / bCount : 0;
                
                return aAvgX - bAvgX;
            });
        }
        
        // Centering if requested
        if (config.centerLevels) {
            var totalWidth = 0;
            level.forEach(function(node) {
                totalWidth += (node.element.bounds.width || 120);
            });
            totalWidth += (level.length - 1) * config.hSpacing;
            currentX = Math.max(config.marginLeft, (1200 - totalWidth) / 2);
        }
        
        level.forEach(function(node) {
            var elem = node.element;
            var width = elem.bounds.width || 120;
            var height = elem.bounds.height || 60;
            
            elem.bounds = {
                x: Math.round(currentX),
                y: Math.round(currentY),
                width: width,
                height: height
            };
            
            currentX += width + config.hSpacing;
            maxHeight = Math.max(maxHeight, height);
        });
        
        currentY += maxHeight + config.vSpacing;
    });
    
    console.log("Hierarchical layout applied");
}

// Grid Layout
function gridLayout() {
    console.log("Applying grid layout...");
    
    var elements = getVisualElements();
    var cols = config.gridColumns > 0 ? config.gridColumns : Math.ceil(Math.sqrt(elements.length));
    
    console.log("Grid: " + cols + " columns");
    
    var currentX = config.marginLeft;
    var currentY = config.marginTop;
    var maxHeight = 0;
    var colIndex = 0;
    
    elements.forEach(function(elem) {
        var width = elem.element.bounds.width || 120;
        var height = elem.element.bounds.height || 60;
        
        elem.element.bounds = {
            x: currentX,
            y: currentY,
            width: width,
            height: height
        };
        
        maxHeight = Math.max(maxHeight, height);
        colIndex++;
        
        if (colIndex >= cols) {
            colIndex = 0;
            currentX = config.marginLeft;
            currentY += maxHeight + config.vSpacing;
            maxHeight = 0;
        } else {
            currentX += width + config.hSpacing;
        }
    });
    
    console.log("Grid layout applied");
}

// Circular Layout
function circularLayout() {
    console.log("Applying circular layout...");
    
    var elements = getVisualElements();
    var count = elements.length;
    
    if (count === 0) return;
    
    var centerX = 400;
    var centerY = 300;
    var radius = config.circularRadius;
    
    console.log("Radius: " + radius + "px");
    
    elements.forEach(function(elem, index) {
        var angle = (2 * Math.PI * index) / count;
        var width = elem.element.bounds.width || 120;
        var height = elem.element.bounds.height || 60;
        
        var x = centerX + radius * Math.cos(angle) - width / 2;
        var y = centerY + radius * Math.sin(angle) - height / 2;
        
        elem.element.bounds = {
            x: Math.round(x),
            y: Math.round(y),
            width: width,
            height: height
        };
    });
    
    console.log("Circular layout applied");
}

// Vertical Layout
function verticalLayout() {
    console.log("Applying vertical layout...");
    
    var elements = getVisualElements();
    var currentY = config.marginTop;
    
    elements.forEach(function(elem) {
        var width = elem.element.bounds.width || 120;
        var height = elem.element.bounds.height || 60;
        
        elem.element.bounds = {
            x: config.marginLeft,
            y: currentY,
            width: width,
            height: height
        };
        
        currentY += height + config.vSpacing;
    });
    
    console.log("Vertical layout applied");
}

// Horizontal Layout
function horizontalLayout() {
    console.log("Applying horizontal layout...");
    
    var elements = getVisualElements();
    var currentX = config.marginLeft;
    
    elements.forEach(function(elem) {
        var width = elem.element.bounds.width || 120;
        var height = elem.element.bounds.height || 60;
        
        elem.element.bounds = {
            x: currentX,
            y: config.marginTop,
            width: width,
            height: height
        };
        
        currentX += width + config.hSpacing;
    });
    
    console.log("Horizontal layout applied");
}

// Apply selected layout
console.log("\n=== Applying Layout ===");

switch(config.layoutType) {
    case "Hierarchical":
        layeredLayout();
        break;
    case "Grid":
        gridLayout();
        break;
    case "Circular":
        circularLayout();
        break;
    case "Vertical":
        verticalLayout();
        break;
    case "Horizontal":
        horizontalLayout();
        break;
    default:
        window.alert("Unknown layout type: " + config.layoutType);
        exit();
}

// Confirmation message
var elkNote = "";
if (config.routingType !== "NONE" && config.routingType !== "None") {
    elkNote = "\n\n⚠️ Note: " + config.routingType + " routing requires ELK.\n" +
              "This script optimizes PLACEMENT. For full automatic\n" +
              "routing, use elk_layout_advanced.ajs with ELK.";
}

window.alert(
    "✓ Layout applied successfully!\n\n" +
    "Type: " + config.layoutType + "\n" +
    "Preset: " + config.preset + "\n" +
    "Elements repositioned: " + stats.elements +
    elkNote
);

console.log("=== Completed ===");
