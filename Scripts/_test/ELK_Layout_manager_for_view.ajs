        this.config.optimizeCrossings = this.widgets.checkOptimize.getSelection();
        this.config.favorStraightEdges = this.widgets.checkStraight.getSelection();
        this.config.centerLevels = this.widgets.checkCenter.getSelection();
        this.config.thoroughness = parseInt(this.widgets.spinThoroughness.getText(), 10);
        
