/**
 * export_view
 *  export the properties of the selected views to a CSV file
 * 	if a container (a view or a folder) is selected, all views in the container are exported
 */

const Common = require(__SCRIPTS_DIR__ + "Scripts/_lib/Common.js");
Common.initConsoleLog(__FILE__, true);
const Export = require(__DIR__ + "include_export.js");

Export.exportObjects(Common.OBJECT_TYPE_VIEW);

Common.finishConsoleLog();
