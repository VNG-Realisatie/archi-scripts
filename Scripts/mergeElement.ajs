/**
 * Merge all duplicate elements with the selected elements
 *  - duplicate elements have the same type and the same name
 *  - the selected elements are kept, the duplicates are merged and then deleted
 *
 * Usage:
 *  Select one or more elements
 *  - on a view or in the model-tree
 *  - or select folders/views containing the elements
 *  Run the script
 *
 * (c) 2019 Mark Backer
 *
 * 2019: first version
 * 2021: use Archi merge method
 * 07 2022: keep masters property Object ID, drop the other Object ID's
 * 06 2023: Select one or multiple master elements, all these elements will be merged.
 */
const Common = require(__SCRIPTS_DIR__ + "Scripts/_lib/Common.js");
const Merge = require(__SCRIPTS_DIR__ + "Scripts/_lib/includeMergeConcept.js");
const Selection = require(__SCRIPTS_DIR__ + "Scripts/_lib/selection.js");

Common.initConsoleLog(__FILE__);

let selectedConcepts = Selection.getSelection($(selection), Common.OBJECT_TYPE_ELEMENT);
// console.log(`Selected concepts: ${selectedConcepts}`);
Merge.mergeConcept(selectedConcepts, Common.OBJECT_TYPE_ELEMENT);

Common.finishConsoleLog();
