/*
 * FontDecrease
 *
 * Decrease fontsize by 1, but don't set fontsize smaller than default 9
 *
 * (c) 2019 Mark Backer
 *
 */
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Selection = require(REPO_ROOT + "_lib/selection.js");

let collection = Selection.getVisualSelection($(selection));
Selection.applyToCollection(collection, fontDecrease);
console.log("Script finished\n");

function fontDecrease(obj) {
  // console.log(`- ${obj.name} on view ${obj.view.name}`);
  if (obj.fontSize - 1 >= 9) obj.fontSize = obj.fontSize - 1;
}
