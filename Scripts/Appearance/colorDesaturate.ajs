// chroma-js for all kinds of color conversions and color scales
// api docs https://gka.github.io/chroma.js/
const Chroma = require("chroma-js");
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Selection = require(REPO_ROOT + "_lib/selection.js");

try {
	let collection = Selection.getVisualSelection($(selection));
	Selection.applyToCollection(collection.not("relation"), ColorDesaturate);
	console.log("Script finished\n");
} catch (error) {
	console.log(`> ${typeof error.stack == "undefined" ? error : error.stack}`);
}

/*
 * ColorDesaturate.ajs
 */
function ColorDesaturate(obj) {
	let color = Chroma(obj.lineColor).brighten(2); // ### doesn't change black ..
	obj.lineColor = `${color}`;
	if (obj.fillColor) {
		let color = Chroma(obj.fillColor).desaturate(1);
		obj.fillColor = `${color}`;
		console.log(`>> ${obj.name ? obj.name : obj} desaturated`);
	} else {
		console.log(`>>> ${obj} has no color value (set to default)`);
	}
}