/**
 * Copy the label expression of the selected object and apply to all objects of the same type in the view.
 */
if (typeof require !== "function") { const m = "This script needs jArchi 1.11 or later, with CommonJS on: in Archi, open Preferences > Scripting and tick \"Enable CommonJS Support\" (no such option: update jArchi first). Then run the script again."; try { window.alert(m); } catch (e) { console.error(m); } exit(); }
const REPO_ROOT = (() => { const p = __DIR__.replace(/\\/g, "/"), i = p.indexOf("/Scripts/"); return p.substring(0, i === -1 ? p.length : i + 9); })();
const Log    = require(REPO_ROOT + "_lib/log");
const Selection = require(REPO_ROOT + "_lib/selection.js");

Log.start(__FILE__, true);

try {
  let copyFrom = $(selection).first();
  if (!copyFrom || !copyFrom.view) {
    console.error(`> Select one object in a view`);
  } else {
    let collection = Selection.getVisualSelection($(copyFrom.view), copyFrom.type);
    collection.not($(copyFrom)).each((pasteTo) => {
      pasteTo.labelExpression = copyFrom.labelExpression;
    });

    console.log(`> Label expression copied to ${collection.size()} objects`);
  }
} catch (error) {
  console.error(`> ${typeof error.stack == "undefined" ? error : error.stack}`);
}

Log.finish();
