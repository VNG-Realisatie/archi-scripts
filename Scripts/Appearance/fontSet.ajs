/**
 * FontSet
 *  Set the font to given type and size
 */
const Selection = require(__DIR__ + "/../_lib/selection.js");

let collection = Selection.getVisualSelection($(selection));
Selection.applyToCollection(collection, labelSet, ["Arial", 12]);
console.log("Script finished\n");

function labelSet(obj, args) {
  obj.fontName = args[0];
  obj.fontSize = args[1];
}
